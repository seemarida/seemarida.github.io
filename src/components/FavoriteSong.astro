---
interface Props {
  title: string;
  artist: string;
  albumArt: string;
}

const { title, artist, albumArt } = Astro.props;
---

<div class="favorite-song-container">
  <div class="vinyl-container">
    <div class="vinyl-disc" style={`--album-art: url(${albumArt})`}>
      <div class="vinyl-inner-circle"></div>
    </div>
  </div>
  <div class="song-details">
    <h3>{title}</h3>
    <p>{artist}</p>
  </div>
</div>

<style>
  .favorite-song-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.5rem;
    border-radius: 1rem;
    @apply bg-light-pink bg-opacity-30;
    max-width: 300px;
    margin: 0 auto;
  }

  .vinyl-container {
    width: 220px;
    height: 220px;
    position: relative;
    perspective: 1000px;
    margin-bottom: 1rem;
  }

  .vinyl-disc {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    @apply bg-gradient-to-br from-gray-800 to-gray-700;
    position: relative;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    transform-style: preserve-3d;
    animation: spin 8s linear infinite;
  }

  .vinyl-disc::before {
    content: "";
    position: absolute;
    top: 10%;
    left: 10%;
    right: 10%;
    bottom: 10%;
    border-radius: 50%;
    background-image: var(--album-art);
    background-size: cover;
    background-position: center;
    z-index: 1;
  }

  .vinyl-inner-circle {
    position: absolute;
    width: 30%;
    height: 30%;
    border-radius: 50%;
    @apply bg-gradient-to-br from-gray-100 to-gray-200;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    box-shadow: inset 0 0 2px rgba(0, 0, 0, 0.5);
  }

  .song-details {
    text-align: center;
    width: 100%;
  }

  .song-details h3 {
    font-weight: 700;
    margin-bottom: 0.25rem;
    font-size: 1.25rem;
    @apply text-gray-700;
  }

  .song-details p {
    font-size: 1rem;
    @apply text-gray-500;
    margin: 0;
  }

  @keyframes spin {
    0% {
      transform: rotateY(0deg) rotate(0deg);
    }
    100% {
      transform: rotateY(10deg) rotate(360deg);
    }
  }

  @media (hover: hover) {
    .vinyl-container:hover .vinyl-disc {
      animation-play-state: paused;
    }
  }
</style>