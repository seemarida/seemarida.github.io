---
import { formatDate } from '../utils/formatDate';
import { getTagColor, linkColors } from '../utils/colorUtils';
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';

interface Props {
	post: CollectionEntry<'blog'>;
	isCondensed?: boolean;
}

const { post, isCondensed = false } = Astro.props;
const { data } = post;
// Ensure the slug is included and formatted correctly
const url = `/thoughts/${post.slug}/`;

// Generate a random gradient based on the post slug for consistency
const getRandomGradient = (seed: string) => {
	// Simple hash function to generate consistent random numbers from a string
	let hash = 0;
	for (let i = 0; i < seed.length; i++) {
		hash = ((hash << 5) - hash) + seed.charCodeAt(i);
		hash = hash & hash; // Convert to 32bit integer
	}
	
	// Theme colors from tailwind config
	const themeColors = [
		'light-pink', 'soft-blue', 'muted-rose',
		'tag-green', 'tag-yellow', 'tag-orange', 'tag-purple', 'tag-teal'
	];
	
	// Select two colors deterministically based on the hash
	const colorIndex1 = Math.abs(hash) % themeColors.length;
	const colorIndex2 = Math.abs(hash >> 4) % themeColors.length;
	
	// Generate a random angle based on the hash
	const angle = Math.abs(hash % 360);
	
	return `linear-gradient(${angle}deg, var(--color-${themeColors[colorIndex1]}), var(--color-${themeColors[colorIndex2]}))`;
};

// Map icon names to Iconify icon sets
const getIconName = (iconName: string) => {
	switch (iconName) {
		case 'brain':
			return 'mdi:brain';
		case 'meditation':
			return 'mdi:meditation';
		case 'memory':
			return 'mdi:memory';
		case 'neuron':
			return 'mdi:electron-framework';
		case 'research':
			return 'mdi:flask-outline';
		case 'book':
			return 'mdi:book-open-page-variant';
		default:
			return iconName && iconName.includes(':') ? iconName : 'mdi:help-circle';
	}
};

// Gradient style for the post header
const gradientStyle = getRandomGradient(post.slug);
const iconName = data.icon ? getIconName(data.icon) : '';
---

<article
	class={`blog-post ${data.featured && !isCondensed ? 'featured' : ''} bg-white bg-opacity-70 rounded-lg shadow-md overflow-hidden transition-all duration-300 hover:shadow-lg hover:transform hover:translate-y-[-5px]`}
>
	<div>
		{
			!isCondensed ? (
				<div class="relative h-48 overflow-hidden" style={`background: ${gradientStyle}`}>
					<div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent z-10" />
					{data.image ? (
						<a href={url} class="block cursor-pointer h-full">
							<img
								src={data.image}
								alt={data.title}
								class="w-full h-full object-cover"
							/>
						</a>
					) : data.icon && (
						<>
							<div class="absolute inset-0 flex items-center justify-center text-white z-20">
								<Icon name={iconName} size={64} class="opacity-90" />
							</div>
							<a href={url} class="absolute inset-0 block cursor-pointer h-full z-30"></a>
						</>
					)}
				</div>
			) : null
		}

		<div class="p-6">
			<div class="flex flex-wrap gap-2 mb-3">
				{
					data.tags.slice(0, isCondensed ? 1 : 3).map(tag => {
						const { bg, hover, text } = getTagColor(tag);
						return (
							<a
								href={`/thoughts/tag/${tag}`}
								class={`text-xs ${bg} ${hover} ${text} px-2 py-1 rounded-full transition-colors duration-200`}
							>
								{tag}
							</a>
						);
					})
				}
			</div>

			<h3
				class={`font-bold ${isCondensed ? 'text-lg mb-1' : 'text-2xl mb-3'}`}
			>
				<a
					href={url}
					class={`${linkColors.primary.default} ${linkColors.primary.hover} transition-colors cursor-pointer block`}
				>
					{data.title}
				</a>
			</h3>

			{
				!isCondensed && (
					<p class="text-gray-600 mb-4 line-clamp-3">{data.description}</p>
				)
			}

			<div class="flex justify-between items-center text-sm text-gray-500">
				<time datetime={data.pubDate.toISOString()}>
					{formatDate(data.pubDate)}
				</time>

				{
					!isCondensed && (
						<a
							href={url}
							class={`${linkColors.secondary.default} ${linkColors.secondary.hover} transition-colors cursor-pointer inline-block`}
						>
							Read more →
						</a>
					)
				}
			</div>
		</div>
	</div>
</article>

<style>
	.featured {
		@apply border-l-4 border-muted-rose;
	}

	.line-clamp-3 {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>

<script>
	// Add client-side click handler to ensure navigation works
	document.addEventListener('astro:page-load', () => {
		const blogPosts = document.querySelectorAll('.blog-post');

		blogPosts.forEach(post => {
			// Get the URL to the article page (not tag links)
			const titleLink = post.querySelector('h3 a');
			if (!titleLink) return;

			const articleUrl = titleLink.getAttribute('href');
			if (!articleUrl) return;

			// Add click handler to the entire post
			post.addEventListener('click', e => {
				// Find the closest anchor tag to the clicked element
				const clickedLink = e.target.closest('a');
				
				// If clicked directly on a tag link, let the default behavior happen
				if (clickedLink && clickedLink.getAttribute('href').startsWith('/thoughts/tag/')) {
					e.stopPropagation(); // Stop event from bubbling up
					return;
				}
				
				// If clicked directly on any link, let the default behavior happen
				if (clickedLink) {
					return;
				}
				
				// Otherwise, navigate to the article page
				window.location.href = articleUrl;
			});

			// Make the entire post look clickable
			post.style.cursor = 'pointer';
		});
	});
</script>