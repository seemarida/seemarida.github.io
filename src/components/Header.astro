---
import { navItems } from '../data/navigation.js';
import { siteConfig } from '../data/siteConfig.js';
import { Icon } from 'astro-icon/components';

const currentPath = Astro.url.pathname;
---

<header
	class="bg-light-pink bg-opacity-80 backdrop-blur-sm sticky top-0 z-10 shadow-md transition-all duration-300"
>
	<div
		class="container py-4 flex flex-col md:flex-row justify-between items-center"
	>
		<div class="mb-4 md:mb-0">
			<a
				href="/"
				class="flex items-center group transition-all duration-300"
			>
				<div class="mr-2 text-soft-blue group-hover:text-muted-rose transition-all duration-300">
					<!-- <Icon name="mdi:brain" size="32" /> -->
					<!-- <img src="/brain.svg" /> -->
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						width="28"
						height="28"
						fill="currentColor"
						class="flex-shrink-0"
					>
						<path d="M12 2C8.27 2 5 5.14 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1s1-.45 1-1v-2.26c.64.16 1.31.26 2 .26s1.36-.1 2-.26V17c0 .55.45 1 1 1s1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.27-7-7-7zm-2 11c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm4 0c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/>
					</svg>
					<!-- Face image (saved for backup):
					<img src="/face.png" alt="Seema's profile picture" class="w-10 h-10 object-contain align-baseline translate-y-1.5" />
					-->
				</div>
				<span class="text-2xl font-bold group-hover:text-muted-rose transition-all duration-300">{siteConfig.name}</span>
			</a>
		</div>
		<nav>
			<ul class="flex space-x-1 md:space-x-6">
				{
					navItems.map(item => (
						<li>
							<a
								href={item.href}
								class={`px-3 py-2 rounded-lg transition-all duration-300 ${
									(currentPath === item.href) || (item.href !== '/' && currentPath.startsWith(item.href))
										? 'bg-soft-blue text-white font-medium shadow-sm'
										: 'hover:bg-soft-blue hover:bg-opacity-20 text-gray-800 hover:text-gray-800'
								}`}
							>
								{item.text}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
