---
const currentPath = Astro.url.pathname;

const googleDriveResumeLink = "https://drive.google.com/file/d/1vMcm1Vrld1HCFTy2rBo5zAO5CgFo5NxH/view?usp=sharing";

const navItems = [
  { href: '/', text: 'Home', isExternal: false },
  { href: '/projects', text: 'Work', isExternal: false },
  { href: '/about', text: 'About', isExternal: false },
];
---

<header class="sticky top-0 z-10 pt-6 pb-4 bg-creamy-white/95 backdrop-blur-sm border-b border-gray-200">
  <div class="container">
    <nav class="flex justify-center gap-10">
      {navItems.map(item => (
        <a
          href={item.href}
          {...(item.isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          class={`text-base tracking-wider uppercase transition-all duration-300 pb-2 font-medium ${
            !item.isExternal && ((currentPath === item.href) || (item.href !== '/' && currentPath.startsWith(item.href)))
              ? 'text-gray-800 border-b-2 border-gray-800'
              : 'text-gray-500 border-b-2 border-transparent hover:text-gray-800 hover:border-gray-300'
          }`}
        >
          {item.text}
        </a>
      ))}
    </nav>
  </div>
</header>
