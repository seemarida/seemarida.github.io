---
import { navItems } from '../data/navigation.js';
import { siteConfig } from '../data/siteConfig.js';
import { Icon } from 'astro-icon/components';

const currentPath = Astro.url.pathname;
---

<header
	class="bg-light-pink bg-opacity-80 backdrop-blur-sm sticky top-0 z-10 shadow-md transition-all duration-300"
>
	<div
		class="container py-4 flex flex-col md:flex-row justify-between items-center"
	>
		<div class="mb-4 md:mb-0">
			<a
				href="/"
				class="flex items-center group transition-all duration-300"
			>
				<span class="text-2xl font-bold group-hover:text-muted-rose transition-all duration-300">{siteConfig.name}</span>
			</a>
		</div>
		<nav>
			<ul class="flex space-x-1 md:space-x-6">
				{
					navItems.map(item => (
						<li>
							<a
								href={item.href}
								class={`px-3 py-2 rounded-lg transition-all duration-300 ${
									(currentPath === item.href) || (item.href !== '/' && currentPath.startsWith(item.href))
										? 'bg-soft-blue text-white font-medium shadow-sm'
										: 'hover:bg-soft-blue hover:bg-opacity-20 text-gray-800 hover:text-gray-800'
								}`}
							>
								{item.text}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
