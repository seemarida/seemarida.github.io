---
const currentPath = Astro.url.pathname;

const googleDriveResumeLink = "https://drive.google.com/file/d/1vMcm1Vrld1HCFTy2rBo5zAO5CgFo5NxH/view?usp=sharing";

const navItems = [
  { href: '/', text: 'Home', isExternal: false },
  { href: '/about', text: 'About', isExternal: false },
  { href: googleDriveResumeLink, text: 'Resume', isExternal: true },
];
---

<header class="sticky top-0 z-10 pt-6 pb-2">
  <nav class="flex justify-center gap-8">
    {navItems.map(item => (
      <a
        href={item.href}
        {...(item.isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        class={`text-sm tracking-widest uppercase transition-all duration-300 pb-1 ${
          !item.isExternal && ((currentPath === item.href) || (item.href !== '/' && currentPath.startsWith(item.href)))
            ? 'text-gray-800 border-b border-gray-800'
            : 'text-gray-400 border-b border-transparent hover:text-gray-800 hover:border-gray-300'
        }`}
      >
        {item.text}
      </a>
    ))}
  </nav>
</header>
