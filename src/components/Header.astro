---
import { navItems } from '../data/navigation.js';
import { siteConfig } from '../data/siteConfig.js';
import { Icon } from 'astro-icon/components';

const currentPath = Astro.url.pathname;
---

<header
	class="bg-light-pink bg-opacity-80 backdrop-blur-sm sticky top-0 z-10 shadow-md transition-all duration-300"
>
	<div
		class="container py-4 flex flex-col md:flex-row justify-between items-center"
	>
		<div class="mb-4 md:mb-0">
			<a
				href="/"
				class="flex items-center group transition-all duration-300"
			>
				<div class="mr-2 text-soft-blue group-hover:text-muted-rose transition-all duration-300">
					<!-- <Icon name="mdi:brain" size="32" /> -->
					<!-- <img src="/brain.svg" /> -->
					<!-- Brain SVG (saved for backup):
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 60 60"
						width="100%"
						height="100%"
						fill="none"
						stroke="currentColor"
						stroke-width="6"
						stroke-linecap="round"
						stroke-linejoin="round"
						style="width: 25px; height: 25px;"
					>
						<path
							d="M48.643,24.892c-0.687-4.94-4.959-8.724-10.012-8.724c-0.97,0-1.924,0.144-2.84,0.411c-1.912-2.219-4.717-3.536-7.662-3.536 c-3.189,0-6.026,1.469-7.881,3.773c-0.409-0.05-0.821-0.084-1.237-0.084c-5.233,0-9.55,3.992-10.067,9.09 C6.474,27.733,5,30.677,5,33.817c0,5.078,3.765,9.283,8.648,9.999c1.906,1.995,4.544,3.142,7.31,3.142 c2.711,0,5.214-1.081,7.056-2.873c1.251,0.712,2.651,1.105,4.112,1.105c2.581,0,4.892-1.178,6.425-3.023 c1.791,1.442,4,2.23,6.33,2.23c5.58,0,10.119-4.539,10.119-10.118C55,30.028,52.364,26.389,48.643,24.892z"
						></path>
					</svg>
					-->
					<img src="/pfp-removebg-preview.png" alt="Seema's profile picture" class="w-8 h-8 object-contain" />
				</div>
				<span class="text-2xl font-bold group-hover:text-muted-rose transition-all duration-300">{siteConfig.name}</span>
			</a>
		</div>
		<nav>
			<ul class="flex space-x-1 md:space-x-6">
				{
					navItems.map(item => (
						<li>
							<a
								href={item.href}
								class={`px-3 py-2 rounded-lg transition-all duration-300 ${
									(currentPath === item.href) || (item.href !== '/' && currentPath.startsWith(item.href))
										? 'bg-soft-blue text-white font-medium shadow-sm'
										: 'hover:bg-soft-blue hover:bg-opacity-20 text-gray-800 hover:text-gray-800'
								}`}
							>
								{item.text}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
