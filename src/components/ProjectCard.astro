---
interface Props {
	title: string;
	description: string;
	abstract?: string;
	tags?: string[];
	projectLink?: string;
	links?: Array<{ text: string; href: string; type?: string }>;
	image?: string;
}

const {
	title,
	description,
	abstract,
	tags = [],
	projectLink,
	links = [],
	image,
} = Astro.props;
---

<div class="mb-12 pb-12 border-b border-gray-200 last:border-b-0 last:pb-0 project-card">
	<div class="mb-4">
		{
			projectLink ? (
				<a
					href={projectLink}
					target="_blank"
					rel="noopener noreferrer"
					class="text-2xl font-bold text-gray-800 hover:text-muted-rose transition-colors underline decoration-2 decoration-transparent hover:decoration-muted-rose"
				>
					{title}
				</a>
			) : (
				<h3 class="text-2xl font-bold text-gray-800">
					{title}
				</h3>
			)
		}
	</div>

	<div class="mb-4">
		{
			image ? (
				<img
					src={image}
					alt={title}
					class="w-full max-w-2xl h-auto rounded-lg shadow-md hover:shadow-lg transition-shadow cursor-pointer"
					onclick="this.classList.toggle('expanded-image')"
				/>
			) : (
				<div class="w-full max-w-2xl h-64 rounded-lg shadow-md bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center border-2 border-dashed border-gray-300">
					<div class="text-center">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto mb-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
						</svg>
						<p class="text-lg font-medium text-gray-500">Visualization Coming Soon</p>
						<p class="text-sm text-gray-400 mt-1">Under Construction</p>
					</div>
				</div>
			)
		}
	</div>

	<p class="text-lg text-gray-700 mb-4 leading-relaxed max-w-4xl">
		{description}
	</p>

	{
		abstract && (
			<div class="mb-4">
				<button
					class="text-soft-blue hover:text-muted-rose transition-colors font-medium underline cursor-pointer toggle-abstract-btn"
					onclick="this.closest('.project-card').querySelector('.project-abstract').classList.toggle('hidden')"
				>
					Show Details →
				</button>
				<div class="project-abstract hidden mt-4 p-4 bg-gray-50 rounded-lg border-l-4 border-muted-rose">
					<p class="text-base text-gray-700 leading-relaxed">
						{abstract}
					</p>
				</div>
			</div>
		)
	}

	{
		tags && tags.length > 0 && (
			<div class="flex flex-wrap gap-2 mb-4">
				{tags.map(tag => (
					<span class="px-3 py-1 bg-muted-rose/15 text-muted-rose rounded-full text-sm font-medium">
						{tag}
					</span>
				))}
			</div>
		)
	}

	{
		(projectLink || links.length > 0) && (
			<div class="flex flex-wrap gap-4">
				{
					projectLink && (
						<a
							href={projectLink}
							target="_blank"
							rel="noopener noreferrer"
							class="text-soft-blue hover:text-muted-rose transition-colors font-medium underline"
						>
							View Project →
						</a>
					)
				}
				{
					links.map(link => (
						<a
							href={link.href}
							target="_blank"
							rel="noopener noreferrer"
							class="text-soft-blue hover:text-muted-rose transition-colors font-medium underline"
						>
							{link.text} →
						</a>
					))
				}
			</div>
		)
	}
</div>

<style>
	.expanded-image {
		max-width: 100% !important;
		cursor: zoom-out;
	}

	.project-abstract {
		animation: slideDown 0.3s ease-out;
	}

	@keyframes slideDown {
		from {
			opacity: 0;
			transform: translateY(-10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>

<script>
	// Update button text when toggling abstract
	document.addEventListener('DOMContentLoaded', () => {
		const buttons = document.querySelectorAll('.toggle-abstract-btn');
		buttons.forEach(button => {
			button.addEventListener('click', () => {
				const isHidden = button.closest('.project-card')?.querySelector('.project-abstract')?.classList.contains('hidden');
				button.textContent = isHidden ? 'Hide Details ↑' : 'Show Details →';
			});
		});
	});
</script>
