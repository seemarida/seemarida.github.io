---
import { siteConfig, footerSocialLinks } from '../data/siteConfig.js';
import { Icon } from 'astro-icon/components';

const currentYear = new Date().getFullYear();

// Map social icons to Iconify icon sets
const getSocialIcon = (icon: string) => {
	switch (icon) {
		case 'github':
			return 'mdi:github';
		case 'email':
			return 'mdi:email';
		case 'linkedin':
			return 'mdi:linkedin';
		case 'spotify':
			return 'mdi:spotify';
		default:
			return 'mdi:web';
	}
};
---

<footer class="bg-light-pink bg-opacity-80 backdrop-blur-sm mt-auto py-6">
	<div class="container text-center md:flex md:justify-between md:items-center">
		<div>
			<p class="text-sm mb-2 md:mb-0">
				&copy; {currentYear}
				{siteConfig.name}. All rights reserved.
			</p>
		</div>


		<div class="flex justify-center space-x-4">
			{
				footerSocialLinks.map((link) => (
					<a
						href={link.href}
						target="_blank"
						rel="noopener noreferrer"
						class="text-gray-700 hover:text-muted-rose transition-all duration-300 hover:transform hover:translate-y-[-2px] p-2 relative group"
						title={link.description}
					>
						<span class="sr-only">{link.name}</span>
						<Icon name={getSocialIcon(link.icon)} size="24" />
						{link.icon === 'email' && (
							<div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-gray-800 text-white text-xs rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap pointer-events-none">
								{link.description}
							</div>
						)}
					</a>
				))
			}
		</div>
	</div>
</footer>
