---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import RetroWindow from '../../../components/RetroWindow.astro';
import { projects } from '../../../data/workData';

export async function getStaticPaths() {
  return projects.map(project => ({
    params: { project: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
---

<SiteLayout title={`${project.label} | Seema Rida`}>
  <main>
    <RetroWindow
      title={`projects / ${project.slug} / about.txt`}
      backLink={`/projects/${project.slug}`}
      backLabel="close"
    >
      <div class="about-content">
        <h1>{project.title}</h1>
        <p class="project-meta">{project.date}</p>
        <p class="project-description">{project.description}</p>

        {project.resources.length > 0 && (
          <div class="resources-section">
            <h2>resources</h2>
            <ul>
              {project.resources.map(resource => (
                <li>
                  <a href={resource.href} target={resource.type === 'code' ? '_blank' : undefined} rel={resource.type === 'code' ? 'noopener noreferrer' : undefined}>
                    {resource.label}
                  </a>
                  <span class="resource-type">({resource.type})</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </RetroWindow>
  </main>

  <style>
    main {
      max-width: 1200px;
      margin: 0 auto;
      padding: 4rem 2rem;
      min-height: calc(100vh - 200px);
    }

    .about-content {
      font-family: 'VT323', monospace;
      font-size: 1.125rem;
      color: #1C1917;
      line-height: 1.6;
      letter-spacing: 0.05em;
    }

    h1 {
      font-family: 'VT323', monospace;
      font-size: 1.5rem;
      font-weight: 400;
      margin-bottom: 1rem;
      color: #1C1917;
    }

    h2 {
      font-family: 'VT323', monospace;
      font-size: 1.25rem;
      font-weight: 400;
      margin: 2rem 0 1rem;
      color: #1C1917;
    }

    .project-meta {
      color: #6B7280;
      margin-bottom: 1.5rem;
    }

    .project-description {
      margin-bottom: 2rem;
      line-height: 1.7;
    }

    .resources-section ul {
      list-style: none;
      padding: 0;
    }

    .resources-section li {
      margin-bottom: 0.75rem;
      padding-left: 1.5rem;
      position: relative;
    }

    .resources-section li::before {
      content: '>';
      position: absolute;
      left: 0;
      color: #6FAB84;
    }

    .resources-section a {
      color: #1C1917;
      text-decoration: none;
      transition: none;
    }

    .resources-section a:hover {
      color: #6FAB84;
      text-decoration: underline;
    }

    .resources-section a:focus {
      outline: 2px solid #6FAB84;
      outline-offset: 2px;
    }

    .resource-type {
      color: #6B7280;
      margin-left: 0.5rem;
      font-size: 1rem;
    }

    @media (max-width: 768px) {
      main {
        padding: 3rem 1rem;
      }

      h1 {
        font-size: 1.25rem;
      }

      .about-content {
        font-size: 1rem;
      }
    }
  </style>
</SiteLayout>
