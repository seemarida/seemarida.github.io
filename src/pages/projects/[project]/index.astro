---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import RetroWindow from '../../../components/RetroWindow.astro';
import { projects } from '../../../data/workData';

export async function getStaticPaths() {
  return projects.map(project => ({
    params: { project: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const itemCount = 1 + project.resources.length;
---

<SiteLayout title={`${project.label} | Seema Rida`}>
  <main>
    <RetroWindow
      title={`projects / ${project.slug}`}
      objectCount={itemCount}
      backLink="/projects"
    >
      <div class="files-grid">
        <!-- about.txt always present -->
        <a href={`/projects/${project.slug}/about`} class="file-link">
          <svg viewBox="0 0 80 100" class="file-icon" aria-hidden="true">
            <!-- Page with folded corner -->
            <path
              d="M 10 10 L 10 90 L 70 90 L 70 30 L 50 10 Z"
              fill="#F8F6F4"
              stroke="#1C1917"
              stroke-width="2"
              shape-rendering="crispEdges"
            />
            <!-- Folded corner -->
            <path
              d="M 50 10 L 50 30 L 70 30"
              fill="#E7E3DC"
              stroke="#1C1917"
              stroke-width="2"
              shape-rendering="crispEdges"
            />
            <!-- Text lines -->
            <line x1="20" y1="45" x2="60" y2="45" stroke="#6FAB84" stroke-width="2" shape-rendering="crispEdges" />
            <line x1="20" y1="55" x2="60" y2="55" stroke="#6FAB84" stroke-width="2" shape-rendering="crispEdges" />
            <line x1="20" y1="65" x2="50" y2="65" stroke="#6FAB84" stroke-width="2" shape-rendering="crispEdges" />
          </svg>
          <span class="file-label">about.txt</span>
        </a>

        <!-- Resources -->
        {project.resources.map(resource => {
          const isPDF = resource.type === 'paper' || resource.type === 'poster' || resource.type === 'slides';
          const isPhoto = resource.type === 'photos';
          const isDemo = resource.type === 'demo';
          const isCode = resource.type === 'code';
          const target = isPDF || isDemo || isCode ? '_blank' : undefined;
          const rel = isCode ? 'noopener noreferrer' : undefined;

          return (
            <a
              href={resource.href}
              class={`file-link ${isPhoto ? 'photo-link' : ''}`}
              target={target}
              rel={rel}
              data-lightbox={isPhoto ? resource.href : undefined}
              data-alt={isPhoto ? resource.label : undefined}
            >
              {isPDF && (
                <svg viewBox="0 0 80 100" class="file-icon" aria-hidden="true">
                  <path
                    d="M 10 10 L 10 90 L 70 90 L 70 30 L 50 10 Z"
                    fill="#F8F6F4"
                    stroke="#1C1917"
                    stroke-width="2"
                    shape-rendering="crispEdges"
                  />
                  <path
                    d="M 50 10 L 50 30 L 70 30"
                    fill="#E7E3DC"
                    stroke="#1C1917"
                    stroke-width="2"
                    shape-rendering="crispEdges"
                  />
                  <rect x="15" y="40" width="50" height="45" fill="#6FAB84" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
                  <text x="40" y="68" font-family="VT323, monospace" font-size="18" fill="#F8F6F4" text-anchor="middle">PDF</text>
                </svg>
              )}
              {isPhoto && resource.thumbnail && (
                <div class="photo-icon">
                  <img src={resource.thumbnail} alt={resource.label} />
                </div>
              )}
              {isDemo && (
                <svg viewBox="0 0 80 80" class="file-icon" aria-hidden="true">
                  <rect x="5" y="15" width="70" height="50" fill="#6FAB84" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
                  <rect x="10" y="20" width="60" height="35" fill="#F8F6F4" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
                  <rect x="35" y="65" width="10" height="10" fill="#1C1917" shape-rendering="crispEdges" />
                </svg>
              )}
              {isCode && (
                <svg viewBox="0 0 80 100" class="file-icon" aria-hidden="true">
                  <path
                    d="M 10 10 L 10 90 L 70 90 L 70 30 L 50 10 Z"
                    fill="#F8F6F4"
                    stroke="#1C1917"
                    stroke-width="2"
                    shape-rendering="crispEdges"
                  />
                  <path
                    d="M 50 10 L 50 30 L 70 30"
                    fill="#E7E3DC"
                    stroke="#1C1917"
                    stroke-width="2"
                    shape-rendering="crispEdges"
                  />
                  <text x="40" y="65" font-family="VT323, monospace" font-size="24" fill="#6FAB84" text-anchor="middle">&lt;/&gt;</text>
                </svg>
              )}
              <span class="file-label">{resource.label}</span>
            </a>
          );
        })}
      </div>
    </RetroWindow>
  </main>

  <style>
    main {
      max-width: 1200px;
      margin: 0 auto;
      padding: 4rem 2rem;
      min-height: calc(100vh - 200px);
    }

    .files-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(100px, 120px));
      gap: 2.5rem 2rem;
      justify-content: center;
    }

    .file-link {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      text-decoration: none;
      padding: 0.5rem;
      transition: none;
    }

    .file-icon {
      width: 80px;
      height: 100px;
    }

    .photo-icon {
      width: 80px;
      height: 80px;
      border: 2px solid #1C1917;
      overflow: hidden;
      background: #F8F6F4;
    }

    .photo-icon img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .file-label {
      font-family: 'VT323', monospace;
      font-size: 1rem;
      color: #1C1917;
      text-align: center;
      line-height: 1.2;
      letter-spacing: 0.05em;
      word-wrap: break-word;
      max-width: 100%;
      padding: 0.25rem 0.5rem;
    }

    @media (prefers-reduced-motion: no-preference) {
      .file-link:hover .file-label,
      .file-link:focus .file-label {
        animation: invertLabel 0.1s steps(1) forwards;
      }
    }

    @keyframes invertLabel {
      to {
        background: #1C1917;
        color: #F8F6F4;
      }
    }

    .file-link:hover .file-label,
    .file-link:focus .file-label {
      background: #1C1917;
      color: #F8F6F4;
    }

    .file-link:focus {
      outline: 2px solid #6FAB84;
      outline-offset: 4px;
    }

    @media (max-width: 768px) {
      main {
        padding: 3rem 1rem;
      }

      .files-grid {
        grid-template-columns: repeat(auto-fill, minmax(90px, 110px));
        gap: 2rem 1.5rem;
      }

      .file-icon {
        width: 70px;
        height: 87.5px;
      }

      .photo-icon {
        width: 70px;
        height: 70px;
      }

      .file-label {
        font-size: 0.9375rem;
      }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const photoLinks = document.querySelectorAll('.photo-link');

      photoLinks.forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const href = link.getAttribute('data-lightbox');
          const alt = link.getAttribute('data-alt') || '';

          const lightbox = document.createElement('div');
          lightbox.className = 'lightbox';
          lightbox.innerHTML = `
            <div class="lightbox-content">
              <img src="${href}" alt="${alt}" />
              <p class="lightbox-caption">${alt}</p>
            </div>
          `;

          document.body.appendChild(lightbox);
          document.body.style.overflow = 'hidden';

          const closeLightbox = () => {
            document.body.removeChild(lightbox);
            document.body.style.overflow = '';
          };

          lightbox.addEventListener('click', closeLightbox);

          document.addEventListener('keydown', function escHandler(e) {
            if (e.key === 'Escape') {
              closeLightbox();
              document.removeEventListener('keydown', escHandler);
            }
          });
        });
      });
    });
  </script>

  <style is:global>
    .lightbox {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(28, 25, 23, 0.95);
      z-index: 10000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      cursor: pointer;
    }

    .lightbox-content {
      max-width: 90%;
      max-height: 90%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    .lightbox-content img {
      max-width: 100%;
      max-height: calc(90vh - 4rem);
      border: 2px solid #F8F6F4;
      background: #F8F6F4;
    }

    .lightbox-caption {
      font-family: 'VT323', monospace;
      font-size: 1.25rem;
      color: #F8F6F4;
      text-align: center;
    }
  </style>
</SiteLayout>
