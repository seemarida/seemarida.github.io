---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout
	title="EEG-based Attention Classification | Seema Rida"
	description="EEG-based attention classification pipeline for adaptive neurofeedback using real-time OpenBCI data"
>
	<div class="max-w-6xl mx-auto py-12 px-4">
		<div class="text-center mb-8">
			<h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4">EEG-based Attention Classification</h1>
			<div class="w-16 h-0.5 bg-muted-rose mx-auto mb-6"></div>
			<p class="text-gray-600 text-lg max-w-2xl mx-auto">
				Designed an EEG-based attention classification pipeline for an adaptive neurofeedback system using real-time OpenBCI data, signal preprocessing, and frequency-domain analysis
			</p>
		</div>

		<!-- Project Image/GIF -->
		<div class="bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden mb-8 flex items-center justify-center" style="min-height: 400px;">
			<img
				src="/eeg_light.gif"
				alt="EEG Attention Classification Demo"
				class="w-full h-full object-contain"
			/>
		</div>

		<!-- Project Description -->
		<div class="max-w-3xl mx-auto mb-8">
			<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8">
				<h2 class="text-2xl font-bold text-gray-800 mb-4">About This Project</h2>
				<p class="text-gray-600 leading-relaxed mb-4">
					This project developed a comprehensive EEG-based attention classification pipeline for an adaptive neurofeedback system. Using real-time data from OpenBCI headsets, I designed experiments to examine attentional fluctuations during cognitive task performance.
				</p>
				<p class="text-gray-600 leading-relaxed mb-4">
					The pipeline includes signal preprocessing with bandpass filtering and epoching, frequency-domain analysis to identify attention-related brainwave patterns, and machine learning models to classify attention levels from EEG features with significant accuracy.
				</p>
				<div class="flex flex-wrap gap-2 mt-6">
					<span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">Neuroscience</span>
					<span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">Signal Processing</span>
					<span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">BCI</span>
					<span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">Real-time Systems</span>
					<span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">Python</span>
					<span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">EEG</span>
				</div>
			</div>
		</div>

		<!-- Project Links -->
		<div class="flex flex-wrap justify-center gap-4 mb-8">
			<a
				href="https://github.com/seemarida/cogs_189_project"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center px-6 py-3 bg-gray-800 text-white rounded-lg hover:bg-gray-700 transition-colors font-medium"
			>
				<svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
					<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
				</svg>
				View Code
			</a>
			<a
				href="/projects/cogs189_final_project.pdf"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center px-6 py-3 bg-muted-rose text-white rounded-lg hover:bg-opacity-90 transition-colors font-medium"
			>
				<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
				</svg>
				View Presentation
			</a>
		</div>

		<div class="text-center">
			<a href="/" class="inline-block text-muted-rose hover:text-gray-800 transition-colors font-medium">&larr; Back to home</a>
		</div>
	</div>
</MainLayout>
