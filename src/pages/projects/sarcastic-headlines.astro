---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout
	title="Sarcastic Headline Generator | Seema Rida"
	description="Sarcastic Headline Generator project — coming soon"
>
	<div class="max-w-3xl mx-auto py-24 px-4 text-center">
		<h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-4" style="margin-bottom: 1rem;">Sarcastic Headline Generator</h1>
		<div class="w-16 h-0.5 bg-muted-rose mx-auto mb-12"></div>

		<div class="bg-white rounded-2xl shadow-md border border-gray-100 p-12 md:p-16">
			<svg class="w-20 h-20 mx-auto mb-6 text-muted-rose opacity-60" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
			</svg>
			<h2 class="text-2xl font-bold text-gray-700 mb-3">Coming Soon</h2>
			<p class="text-gray-500 text-lg">This project page is under construction. Check back soon.</p>
		</div>

		<a href="/" class="inline-block mt-10 text-muted-rose hover:text-gray-800 transition-colors font-medium">&larr; Back to home</a>
	</div>
</MainLayout>
