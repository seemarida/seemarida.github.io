---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
	title="Lost in Thought | 404"
	description="404 - Lost in thought, this page doesn't exist"
>
	<div
		class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4"
	>
		<h1
			class="text-7xl md:text-9xl font-bold text-soft-blue animate-float mb-4"
		>
			404
		</h1>

		<div class="max-w-md mx-auto">
			<h2 class="text-2xl md:text-3xl font-bold mb-4">Lost?</h2>
			<p class="text-xl text-gray-600 mb-8">This page doesn't exist.</p>

			<div class="flex flex-wrap justify-center gap-4">
				<a
					href="/"
					class="btn btn-primary transition-all duration-300 hover:shadow-lg hover:transform hover:scale-105"
				>
					Return to Home
				</a>
			</div>
		</div>
	</div>
</MainLayout>
