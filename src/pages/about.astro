---
import MainLayout from '../layouts/MainLayout.astro';
import { aboutContent } from '../data/aboutContent.ts';
import { siteConfig } from '../data/siteConfig.js';
---

<MainLayout
	title={`${siteConfig.name} | About`}
	description={aboutContent.pageDescription}
>
	<div class="max-w-5xl mx-auto px-4 md:px-8 py-8">

		<!-- ========== HERO: Headshot left, bio right ========== -->
		<section class="flex flex-col md:flex-row gap-10 items-start mb-16">
			<!-- Headshot -->
			<div class="flex-shrink-0 flex flex-col items-center">
				<div class="w-56 h-56 md:w-64 md:h-64 rounded-2xl overflow-hidden shadow-lg border-4 border-white">
					<img src="/headshot.png" alt="Seema Rida" class="w-full h-full object-cover" />
				</div>
			</div>

			<!-- Bio -->
			<div class="flex-1">
				<h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-2" style="margin-bottom: 0.5rem;">About Me</h1>
				<p class="text-lg text-muted-rose font-light mb-4">Cognitive Science &amp; Machine Learning at UCSD</p>
				<p class="text-base md:text-lg text-gray-700 leading-relaxed" style="margin-bottom: 0;">
					{aboutContent.profile.bio[0]}
				</p>
			</div>
		</section>

		<!-- ========== RESEARCH EXPERIENCE + SKILLS (side by side) ========== -->
		<section class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
			<!-- Left: Research & Education Timeline -->
			<div>
				<h2 class="text-2xl font-bold text-gray-800 mb-6" style="margin-bottom: 1.5rem;">Research &amp; Education</h2>

				<!-- Timeline -->
				<div class="relative">
					<!-- vertical line -->
					<div class="absolute left-4 top-0 bottom-0 w-0.5 bg-muted-rose/30"></div>

					<!-- Item: Current Research -->
					<div class="relative pl-12 pb-8">
						<div class="absolute left-2.5 top-1.5 w-3 h-3 rounded-full bg-muted-rose border-2 border-white shadow"></div>
						<span class="text-xs font-semibold text-muted-rose uppercase tracking-widest">Summer 2025 – Present</span>
						<h3 class="text-lg font-bold text-gray-800 mt-0.5" style="margin-bottom: 0.25rem;">Research Assistant — Chiba Lab</h3>
						<p class="text-sm text-gray-600" style="margin-bottom: 0;">UC Scholars Summer Research Program. Developing a time-synchronized embedded system to analyze student behavior and wellbeing in classroom environments through multimodal data collection.</p>
					</div>

					<!-- Item: Education -->
					<div class="relative pl-12 pb-8">
						<div class="absolute left-2.5 top-1.5 w-3 h-3 rounded-full bg-muted-rose/60 border-2 border-white shadow"></div>
						<span class="text-xs font-semibold text-muted-rose uppercase tracking-widest">2022 – Present</span>
						<h3 class="text-lg font-bold text-gray-800 mt-0.5" style="margin-bottom: 0.25rem;">B.S. Cognitive Science</h3>
						<p class="text-sm text-gray-600" style="margin-bottom: 0;">University of California, San Diego — Specialization in Machine Learning &amp; Neural Computation. Minor in Computer Science.</p>
					</div>

					<!-- Item: placeholder for future -->
					<div class="relative pl-12">
						<div class="absolute left-2.5 top-1.5 w-3 h-3 rounded-full bg-gray-300 border-2 border-white shadow"></div>
						<span class="text-xs font-semibold text-gray-400 uppercase tracking-widest">More to come</span>
						<h3 class="text-lg font-bold text-gray-400 mt-0.5" style="margin-bottom: 0.25rem;">...</h3>
					</div>
				</div>
			</div>

			<!-- Right: Skills -->
			<div>
				<h2 class="text-2xl font-bold text-gray-800 mb-6" style="margin-bottom: 1.5rem;">Skills</h2>

				<!-- Technical -->
				<div class="mb-6">
					<h3 class="text-sm font-semibold text-muted-rose uppercase tracking-widest mb-3">Technical</h3>
					<div class="flex flex-wrap gap-2">
						{aboutContent.skills.techniques.items.map(skill => (
							<span class="px-3 py-1 bg-muted-rose/10 text-gray-700 rounded-full text-sm border border-muted-rose/20">{skill}</span>
						))}
					</div>
				</div>

				<!-- Research -->
				<div>
					<h3 class="text-sm font-semibold text-muted-rose uppercase tracking-widest mb-3">Research</h3>
					<div class="flex flex-wrap gap-2">
						{aboutContent.skills.technologies.items.map(skill => (
							<span class="px-3 py-1 bg-purple-50 text-gray-700 rounded-full text-sm border border-purple-200">{skill}</span>
						))}
					</div>
				</div>
			</div>
		</section>

		<!-- ========== LEADERSHIP ========== -->
		<section class="mb-16">
			<h2 class="text-2xl font-bold text-gray-800 mb-6" style="margin-bottom: 1.5rem;">Leadership</h2>
			<div class="space-y-3">
				<div class="flex flex-col sm:flex-row sm:items-center gap-2 bg-white rounded-xl p-4 shadow-sm border border-gray-100">
					<span class="font-semibold text-gray-800">Tritons Prosthetics Society</span>
					<span class="text-gray-300 hidden sm:inline">|</span>
					<span class="text-gray-600">Co-President</span>
				</div>
			</div>
		</section>

		<!-- ========== FAVORITES / HOBBIES ========== -->
		<section class="mb-16">
			<h2 class="text-2xl font-bold text-gray-800 mb-8" style="margin-bottom: 2rem;">a few of my favorites</h2>

			<!-- Grid of interest cards -->
			<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 mb-10">
				<!-- Walk / Hike -->
				<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 text-center hover:shadow-md transition-shadow">
					<div class="text-2xl mb-1">🥾</div>
					<h4 class="text-sm font-bold text-gray-800 mb-0.5">Favorite Hike</h4>
					<p class="text-xs text-gray-500" style="margin-bottom: 0;">Torrey Pines</p>
				</div>

				<!-- Song -->
				<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 text-center hover:shadow-md transition-shadow">
					<div class="text-2xl mb-1">🎵</div>
					<h4 class="text-sm font-bold text-gray-800 mb-0.5">Song on Repeat</h4>
					<p class="text-xs text-gray-500" style="margin-bottom: 0;">You Make Loving Fun — Fleetwood Mac</p>
				</div>

				<!-- Book -->
				<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 text-center hover:shadow-md transition-shadow">
					<div class="text-2xl mb-1">📖</div>
					<h4 class="text-sm font-bold text-gray-800 mb-0.5">Current Read</h4>
					<p class="text-xs text-gray-500" style="margin-bottom: 0;">Thinking, Fast and Slow</p>
				</div>

				<!-- Hobby -->
				<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 text-center hover:shadow-md transition-shadow">
					<div class="text-2xl mb-1">🎹</div>
					<h4 class="text-sm font-bold text-gray-800 mb-0.5">Hobby</h4>
					<p class="text-xs text-gray-500" style="margin-bottom: 0;">Playing piano</p>
				</div>

				<!-- Food -->
				<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 text-center hover:shadow-md transition-shadow">
					<div class="text-2xl mb-1">🍜</div>
					<h4 class="text-sm font-bold text-gray-800 mb-0.5">Favorite Food</h4>
					<p class="text-xs text-gray-500" style="margin-bottom: 0;">Ramen</p>
				</div>

				<!-- Music collection -->
				<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 text-center hover:shadow-md transition-shadow">
					<div class="text-2xl mb-1">💿</div>
					<h4 class="text-sm font-bold text-gray-800 mb-0.5">Collecting</h4>
					<p class="text-xs text-gray-500" style="margin-bottom: 0;">CDs</p>
				</div>

				<!-- Fitness -->
				<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 text-center hover:shadow-md transition-shadow">
					<div class="text-2xl mb-1">💪</div>
					<h4 class="text-sm font-bold text-gray-800 mb-0.5">At the Gym</h4>
					<p class="text-xs text-gray-500" style="margin-bottom: 0;">Bench press</p>
				</div>

				<!-- Playlists -->
				<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 text-center hover:shadow-md transition-shadow">
					<div class="text-2xl mb-1">🎧</div>
					<h4 class="text-sm font-bold text-gray-800 mb-0.5">Always Doing</h4>
					<p class="text-xs text-gray-500" style="margin-bottom: 0;">Making playlists</p>
				</div>
			</div>

			<!-- Photo collage -->
			<div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
				<div class="rounded-xl overflow-hidden shadow-sm border border-gray-100" style="aspect-ratio: 1;">
					<img src="/images/IMG_6871.jpeg" alt="Beach sunset" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
				</div>
				<div class="rounded-xl overflow-hidden shadow-sm border border-gray-100" style="aspect-ratio: 1;">
					<img src="/images/favorite-photo.jpg" alt="Favorite photo" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
				</div>
				<div class="rounded-xl overflow-hidden shadow-sm border border-gray-100" style="aspect-ratio: 1;">
					<img src="/images/fleetwood.jpg" alt="Fleetwood Mac album" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
				</div>
			</div>
		</section>

		<!-- ========== BOTTOM QUOTE ========== -->
		<div class="text-center py-10 border-t border-gray-100">
			<p class="text-sm text-gray-400 italic">
				This little corner of the internet is where I collect my thoughts about brains, code, and everything in between.
			</p>
			<div class="mt-3 w-12 h-0.5 bg-gradient-to-r from-transparent via-muted-rose to-transparent mx-auto opacity-50"></div>
		</div>
	</div>
</MainLayout>
