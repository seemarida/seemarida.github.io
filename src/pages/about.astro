---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="about | Seema Rida">
  <style>
    .page-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 4rem 2rem;
    }

    h1 {
      font-family: 'Libre Baskerville', serif;
      font-size: 2.5rem;
      font-weight: 400;
      color: #1C1917;
      margin-bottom: 3rem;
      text-align: center;
    }

    /* About Section */
    .about-content {
      display: grid;
      grid-template-columns: 250px 1fr;
      gap: 4rem;
      align-items: start;
      margin-bottom: 5rem;
    }

    .headshot-container {
      position: relative;
      display: inline-block;
    }

    .headshot-container img {
      width: 100%;
      border-radius: 12px;
      border: 2px solid #E7E3DC;
    }

    .headshot-tooltip {
      position: absolute;
      background: rgba(229, 231, 235, 0.95);
      color: #6B7280;
      padding: 6px 14px;
      border-radius: 20px;
      font-family: 'Inter', sans-serif;
      font-size: 0.85rem;
      font-weight: 400;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      white-space: nowrap;
      z-index: 10;
    }

    .headshot-container:hover .headshot-tooltip {
      opacity: 1;
    }

    .about-text {
      font-size: 1.05rem;
      color: #6B7280;
      line-height: 1.8;
    }

    .about-text p {
      margin-bottom: 1.5rem;
    }

    /* Experience Section */
    .experience-columns {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }

    .experience-column h2 {
      font-family: 'Libre Baskerville', serif;
      font-size: 1.3rem;
      font-weight: 600;
      color: #1C1917;
      margin-bottom: 1.5rem;
    }

    .experience-list {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .experience-item {
      border-left: 2px solid #E7E3DC;
      padding-left: 1rem;
      transition: border-color 0.3s ease;
      display: flex;
      gap: 1rem;
    }

    .experience-item:hover {
      border-left-color: #6FAB84;
    }

    .experience-logo {
      width: 40px;
      height: 40px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #FFFFFF;
      border-radius: 8px;
      border: 1px solid #E7E3DC;
      padding: 6px;
    }

    .experience-logo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .experience-content {
      flex: 1;
    }

    .experience-title {
      font-family: 'Inter', sans-serif;
      font-size: 1rem;
      font-weight: 600;
      color: #1C1917;
      margin-bottom: 0.25rem;
    }

    .experience-org {
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      color: #6B7280;
      font-weight: 400;
      margin-bottom: 0.25rem;
    }

    .experience-date {
      font-family: 'Inter', sans-serif;
      font-size: 0.85rem;
      color: #6FAB84;
      font-weight: 400;
    }

    .experience-description {
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      color: #6B7280;
      line-height: 1.6;
      margin-top: 0.5rem;
    }

    @media (max-width: 768px) {
      .page-container {
        padding: 3rem 1.5rem;
      }

      h1 {
        font-size: 2rem;
      }

      .about-content {
        grid-template-columns: 1fr;
        gap: 2rem;
        margin-bottom: 4rem;
      }

      .headshot-container {
        max-width: 300px;
        margin: 0 auto;
      }

      .experience-columns {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
    }
  </style>

  <div class="page-container">
    <h1>about</h1>

    <!-- About Section -->
    <div class="about-content">
      <div class="headshot-container">
        <img src="/headshot.png" alt="Seema Rida headshot" />
        <div class="headshot-tooltip">hey!</div>
      </div>

      <div class="about-text">
        <p>
          I'm a researcher interested in wearable tech, physiology, and behavior. I just graduated from UC San Diego with a B.S. in Cognitive Science (Machine Learning & Neural Computation) and a minor in Computer Science.
        </p>
        <p>
          Understanding how the brain and body work has always been more than academic for me, it's personal. Learning how my own brain works is part of what pulls me toward neurotech and wearables in the first place. Other than my love for research, I enjoy photography, learning and listening to new music, and thrifting!
        </p>
      </div>
    </div>

    <!-- Experience Section -->
    <div class="experience-columns">
      <!-- Experience Column -->
      <div class="experience-column">
        <h2>Experience</h2>
        <div class="experience-list">
          <div class="experience-item">
            <div class="experience-logo">
              <img src="/logos/ucsd.png" alt="UCSD" />
            </div>
            <div class="experience-content">
              <div class="experience-title">Undergraduate Researcher</div>
              <div class="experience-org">Chiba Lab · UCSD</div>
            </div>
          </div>

          <div class="experience-item">
            <div class="experience-logo">
              <img src="/logos/urh.png" alt="URH" />
            </div>
            <div class="experience-content">
              <div class="experience-title">UC Scholar</div>
              <div class="experience-org">Undergraduate Research Hub</div>
            </div>
          </div>

          <div class="experience-item">
            <div class="experience-logo">
              <img src="/logos/abwaab.png" alt="Abwaab" />
            </div>
            <div class="experience-content">
              <div class="experience-title">Data Science Intern</div>
              <div class="experience-org">Abwaab</div>
            </div>
          </div>

          <div class="experience-item">
            <div class="experience-logo">
              <img src="/logos/ira.png" alt="IRA" />
            </div>
            <div class="experience-content">
              <div class="experience-title">Robotics Instructor</div>
              <div class="experience-org">International Robotics Academy</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Leadership & Teaching Column -->
      <div class="experience-column">
        <h2>Leadership & Teaching</h2>
        <div class="experience-list">
          <div class="experience-item">
            <div class="experience-logo">
              <img src="/logos/tps.png" alt="TPS" />
            </div>
            <div class="experience-content">
              <div class="experience-title">Co-President</div>
              <div class="experience-org">Tritons Prosthetic Society</div>
              <div class="experience-date">May 2025 – Jun 2026</div>
              <div class="experience-description">Lead a student org focused on building prosthetics and teaching members the fundamentals of prosthetic design.</div>
            </div>
          </div>

          <div class="experience-item">
            <div class="experience-logo">
              <img src="/logos/ucsd.png" alt="UCSD" />
            </div>
            <div class="experience-content">
              <div class="experience-title">Teaching Assistant</div>
              <div class="experience-org">Neural Signal Processing (COGS 118C)</div>
              <div class="experience-date">Jan 2026 – Jun 2026</div>
              <div class="experience-description">Neural Signal Processing with Prof. Eran Mukamel. I hosted office hours, graded coding assignments, and met with students for project support.</div>
            </div>
          </div>

          <div class="experience-item">
            <div class="experience-logo">
              <img src="/logos/cssa.png" alt="CSSA" />
            </div>
            <div class="experience-content">
              <div class="experience-title">Peer Mentor</div>
              <div class="experience-org">Cognitive Science Student Association</div>
              <div class="experience-date">Nov 2022 – Jun 2026</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Headshot tooltip follower
    const headshotContainer = document.querySelector('.headshot-container');
    const headshotTooltip = document.querySelector('.headshot-tooltip');

    if (headshotContainer && headshotTooltip) {
      headshotContainer.addEventListener('mousemove', (e) => {
        const rect = headshotContainer.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        headshotTooltip.style.left = x + 'px';
        headshotTooltip.style.top = y + 'px';
        headshotTooltip.style.transform = 'translate(-50%, -50%)';
      });
    }
  </script>
</SiteLayout>
