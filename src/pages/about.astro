---
import MainLayout from '../layouts/MainLayout.astro';
import { aboutContent } from '../data/aboutContent.ts';
import { siteConfig } from '../data/siteConfig.js';

const googleDriveResumeLink = "https://drive.google.com/file/d/1vMcm1Vrld1HCFTy2rBo5zAO5CgFo5NxH/view?usp=sharing";
const spotifyLink = "https://open.spotify.com/user/wyklimh7i9katv6ph7rwdc3oz?si=5cf2ec54d8db47da";
---

<MainLayout
	title={`${siteConfig.name} | About`}
	description={aboutContent.pageDescription}
>
	<div class="max-w-5xl mx-auto px-4 md:px-8 py-8">

		<!-- ========== HERO: Headshot left, bio right ========== -->
		<section class="flex flex-col md:flex-row items-start mb-16" style="gap: 3rem;">
			<!-- Headshot — pinned to left edge -->
			<div class="flex-shrink-0" style="margin-left: -1rem;">
				<div class="rounded-2xl overflow-hidden" style="width: 220px; aspect-ratio: 3/4; box-shadow: 0 6px 10px rgba(0,0,0,0.07);">
					<img src="/headshot.png" alt="Seema Rida" class="w-full h-full object-cover" />
				</div>
			</div>

			<!-- Bio -->
			<div class="flex-1 max-w-2xl">
				<p class="text-base md:text-lg text-gray-700 leading-relaxed" style="margin-bottom: 0;">
					{aboutContent.profile.bio[0]}
				</p>
			</div>
		</section>

		<!-- ========== SKILLS & EXPERIENCE ========== -->
		<section class="mb-10">
			<p class="text-xs text-gray-800 uppercase tracking-widest mb-2" style="font-weight: 400; letter-spacing: 0.2em;">Skills &amp; Experience</p>
			<hr class="border-gray-200 mb-5" />

			<div class="flex flex-col lg:flex-row gap-12">

				<!-- LEFT: Experience -->
				<div class="flex-1">
					<h2 class="text-lg font-bold text-gray-800" style="margin-bottom: 1rem;">Experience</h2>
					<div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
						<!-- Research Assistant — Chiba Lab -->
						<div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden" style="aspect-ratio: 1;">
							<div class="w-full h-2/5 bg-gray-100 border-b border-gray-200 flex items-center justify-center">
								<span class="text-xs font-bold text-gray-400 text-center leading-tight">LOGO</span>
							</div>
							<div class="p-3 flex flex-col justify-center h-3/5">
								<h3 class="text-sm font-bold text-gray-800" style="margin-bottom: 0.15rem;">Research Assistant</h3>
								<p class="text-xs text-gray-400" style="margin-bottom: 0;">Chiba Lab · UCSD</p>
								<p class="text-xs text-gray-300 mt-0.5" style="margin-bottom: 0;">Summer 2025</p>
							</div>
						</div>

						<!-- Empty placeholder 1 -->
						<div class="bg-gray-50 rounded-xl border border-dashed border-gray-200 overflow-hidden" style="aspect-ratio: 1;">
							<div class="w-full h-2/5 bg-gray-100 border-b border-gray-200 flex items-center justify-center">
								<span class="text-xs font-bold text-gray-300 text-center leading-tight">LOGO</span>
							</div>
							<div class="p-3 flex flex-col justify-center h-3/5">
								<h3 class="text-sm font-bold text-gray-300" style="margin-bottom: 0.15rem;">Coming soon</h3>
								<p class="text-xs text-gray-300" style="margin-bottom: 0;">—</p>
							</div>
						</div>

						<!-- Empty placeholder 2 -->
						<div class="bg-gray-50 rounded-xl border border-dashed border-gray-200 overflow-hidden" style="aspect-ratio: 1;">
							<div class="w-full h-2/5 bg-gray-100 border-b border-gray-200 flex items-center justify-center">
								<span class="text-xs font-bold text-gray-300 text-center leading-tight">LOGO</span>
							</div>
							<div class="p-3 flex flex-col justify-center h-3/5">
								<h3 class="text-sm font-bold text-gray-300" style="margin-bottom: 0.15rem;">Coming soon</h3>
								<p class="text-xs text-gray-300" style="margin-bottom: 0;">—</p>
							</div>
						</div>

						<!-- Empty placeholder 3 -->
						<div class="bg-gray-50 rounded-xl border border-dashed border-gray-200 overflow-hidden" style="aspect-ratio: 1;">
							<div class="w-full h-2/5 bg-gray-100 border-b border-gray-200 flex items-center justify-center">
								<span class="text-xs font-bold text-gray-300 text-center leading-tight">LOGO</span>
							</div>
							<div class="p-3 flex flex-col justify-center h-3/5">
								<h3 class="text-sm font-bold text-gray-300" style="margin-bottom: 0.15rem;">Coming soon</h3>
								<p class="text-xs text-gray-300" style="margin-bottom: 0;">—</p>
							</div>
						</div>
					</div>
				</div>

				<!-- RIGHT: Skills -->
				<div class="lg:w-72 flex-shrink-0">
					<h2 class="text-lg font-bold text-gray-800" style="margin-bottom: 1rem;">Skills</h2>

					<!-- Technical -->
					<div class="mb-4">
						<h3 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-2">Technical</h3>
						<div class="flex flex-wrap gap-2">
							{aboutContent.skills.techniques.items.map(skill => (
								<span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm border border-gray-200">{skill}</span>
							))}
						</div>
					</div>

					<!-- Research -->
					<div class="mb-4">
						<h3 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-2">Research</h3>
						<div class="flex flex-wrap gap-2">
							{aboutContent.skills.technologies.items.map(skill => (
								<span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm border border-gray-200">{skill}</span>
							))}
						</div>
					</div>
				</div>
			</div>

			<!-- Leadership — below Experience & Skills, black label, role name in grey -->
			<div class="mt-6">
				<h3 class="text-sm font-bold text-gray-800" style="margin-bottom: 0.35rem;">Leadership</h3>
				<p class="text-sm text-gray-800" style="margin-bottom: 0;">Tritons Prosthetics Society <span class="text-gray-300 mx-1">|</span> <span class="text-gray-400">Co-President</span></p>
			</div>
		</section>

		<!-- ========== WANT TO SEE MORE? ========== -->
		<section class="mb-10 text-center">
			<h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-4">Want to see more?</h2>
			<a
				href={googleDriveResumeLink}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-block bg-gray-800 text-white font-semibold px-6 py-2.5 rounded-xl shadow-sm hover:shadow-md hover:bg-gray-700 transition-all duration-300 text-sm"
			>
				View Resume
			</a>
		</section>

		<!-- ========== PROOF OF WORK-LIFE BALANCE + IN MY HEADPHONES (one section) ========== -->
		<section class="mb-16">
			<hr class="border-gray-200 mb-3" />
			<p class="text-xs text-gray-800 uppercase tracking-widest mb-4" style="font-weight: 400; letter-spacing: 0.2em;">Proof of Work-Life Balance</p>

			<!-- Photos: ~1.5x wider, ~3x taller — use grid-cols-4 on sm+ and tall aspect ratio -->
			<div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
				{[1, 2, 3, 4, 5, 6, 7, 8].map((i) => (
					<div class={`photo-tilt photo-tilt-${i % 2 === 0 ? 'right' : 'left'} rounded-lg overflow-hidden bg-gray-100 border border-gray-200 flex items-center justify-center`} style="aspect-ratio: 3/4;">
						<span class="text-xs text-gray-400 font-medium">Photo {i}</span>
					</div>
				))}
			</div>

			<!-- In My Headphones — same section, no divider -->
			<div class="mt-10">
				<p class="text-xs text-gray-800 uppercase tracking-widest mb-4" style="font-weight: 400; letter-spacing: 0.2em;">In My Headphones</p>

				<div class="flex flex-col items-start gap-4">
					<!-- Song card -->
					<div class="flex items-center gap-4 bg-white rounded-2xl shadow-sm border border-gray-100 p-4 max-w-sm w-full">
						<!-- Album art placeholder -->
						<div class="flex-shrink-0 w-16 h-16 rounded-xl overflow-hidden bg-gray-100 border border-gray-200">
							<img src="/images/fleetwood.jpg" alt="Album art" class="w-full h-full object-cover" />
						</div>
						<div class="flex-1 min-w-0">
							<p class="text-base font-bold text-gray-800 truncate" style="margin-bottom: 0.1rem;">You Make Loving Fun</p>
							<p class="text-sm text-gray-400 truncate" style="margin-bottom: 0;">Fleetwood Mac</p>
						</div>
						<!-- Spotify button -->
						<a
							href={spotifyLink}
							target="_blank"
							rel="noopener noreferrer"
							class="flex-shrink-0 flex items-center gap-1.5 bg-green-500 hover:bg-green-600 text-white text-xs font-bold px-3 py-1.5 rounded-full transition-colors duration-200"
						>
							<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.486 2 2 6.486 2 12s4.486 10 10 10 10-4.486 10-10S17.514 2 12 2zm4.535 14.507a.625.625 0 01-.856.186c-2.372-1.411-5.35-1.731-8.883-.949a.625.625 0 01-.748-.469.625.625 0 01.469-.748c3.85-.882 7.147-.518 9.83 1.096a.625.625 0 01.188.883zm1.206-2.68a.781.781 0 01-1.069.235c-2.711-1.666-6.851-2.148-10.072-1.175a.781.781 0 01-.954-.51.781.781 0 01.51-.955c3.538-1.081 7.975-.556 11.035 1.291a.781.781 0 01.234 1.067zm.11-2.789a.938.938 0 01-1.285.281c-3.072-1.888-8.066-2.441-11.886-1.333a.937.937 0 01-1.147-.608.937.937 0 01.609-1.148c4.167-1.272 9.584-.652 13.003 1.482a.938.938 0 01.288 1.28z"/></svg>
							Spotify
						</a>
					</div>
				</div>
			</div>
		</section>

	</div>

	<!-- ========== PHOTO TILT HOVER STYLES ========== -->
	<style is:global>
		.photo-tilt {
			transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease;
			cursor: pointer;
			transform: rotate(0deg);
		}

		.photo-tilt-left:hover {
			transform: rotate(-2.5deg) translateY(-3px);
			box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
		}

		.photo-tilt-right:hover {
			transform: rotate(2.5deg) translateY(-3px);
			box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
		}
	</style>
</MainLayout>
