---
import MainLayout from '../layouts/MainLayout.astro';
import { aboutContent } from '../data/aboutContent.ts';
import { siteConfig } from '../data/siteConfig.js';

const googleDriveResumeLink = "https://drive.google.com/file/d/1vMcm1Vrld1HCFTy2rBo5zAO5CgFo5NxH/view?usp=sharing";
const spotifyLink = "https://open.spotify.com/user/wyklimh7i9katv6ph7rwdc3oz?si=5cf2ec54d8db47da";
---

<MainLayout
	title={`${siteConfig.name} | About`}
	description={aboutContent.pageDescription}
>
	<div class="max-w-5xl mx-auto px-4 md:px-8 py-8">

		<!-- ========== HERO: Headshot left, bio right ========== -->
		<section class="flex flex-col md:flex-row gap-10 items-start mb-16">
			<!-- Headshot -->
			<div class="flex-shrink-0 flex flex-col items-center">
				<div class="w-56 h-56 md:w-64 md:h-64 rounded-2xl overflow-hidden" style="box-shadow: 0 6px 10px rgba(0,0,0,0.07);">
					<img src="/headshot.png" alt="Seema Rida" class="w-full h-full object-cover" />
				</div>
			</div>

			<!-- Bio -->
			<div class="flex-1">
				<p class="text-base md:text-lg text-gray-700 leading-relaxed" style="margin-bottom: 0;">
					{aboutContent.profile.bio[0]}
				</p>
			</div>
		</section>

		<!-- ========== EXPERIENCE ========== -->
		<section class="mb-16">
			<h2 class="text-2xl font-bold text-gray-800 mb-6" style="margin-bottom: 1.5rem;">Experience</h2>

			<div class="space-y-6">
				<!-- Research Assistant — Chiba Lab -->
				<div class="flex items-start gap-5">
					<!-- Logo placeholder -->
					<div class="flex-shrink-0 w-14 h-14 rounded-xl bg-gray-100 border border-gray-200 flex items-center justify-center">
						<span class="text-xs font-bold text-gray-400 text-center leading-tight">LOGO</span>
					</div>
					<div class="flex-1">
						<h3 class="text-lg font-bold text-gray-800" style="margin-bottom: 0.15rem;">Research Assistant</h3>
						<p class="text-sm text-gray-400" style="margin-bottom: 0;">Chiba Lab · UC San Diego · Summer 2025 – Present</p>
					</div>
				</div>

				<!-- B.S. Cognitive Science -->
				<div class="flex items-start gap-5">
					<!-- Logo placeholder -->
					<div class="flex-shrink-0 w-14 h-14 rounded-xl bg-gray-100 border border-gray-200 flex items-center justify-center">
						<span class="text-xs font-bold text-gray-400 text-center leading-tight">LOGO</span>
					</div>
					<div class="flex-1">
						<h3 class="text-lg font-bold text-gray-800" style="margin-bottom: 0.15rem;">B.S. Cognitive Science</h3>
						<p class="text-sm text-gray-400" style="margin-bottom: 0;">UC San Diego · 2022 – Present</p>
					</div>
				</div>
			</div>
		</section>

		<!-- ========== SKILLS ========== -->
		<section class="mb-16">
			<h2 class="text-2xl font-bold text-gray-800 mb-6" style="margin-bottom: 1.5rem;">Skills</h2>

			<!-- Technical -->
			<div class="mb-6">
				<h3 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Technical</h3>
				<div class="flex flex-wrap gap-2">
					{aboutContent.skills.techniques.items.map(skill => (
						<span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm border border-gray-200">{skill}</span>
					))}
				</div>
			</div>

			<!-- Research -->
			<div>
				<h3 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Research</h3>
				<div class="flex flex-wrap gap-2">
					{aboutContent.skills.technologies.items.map(skill => (
						<span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm border border-gray-200">{skill}</span>
					))}
				</div>
			</div>
		</section>

		<!-- ========== LEADERSHIP ========== -->
		<section class="mb-16">
			<h2 class="text-2xl font-bold text-gray-800 mb-6" style="margin-bottom: 1.5rem;">Leadership</h2>
			<div class="space-y-3">
				<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 bg-white rounded-xl p-4 shadow-sm border border-gray-100">
					<div class="flex flex-col sm:flex-row sm:items-center gap-2">
						<span class="font-semibold text-gray-800">Tritons Prosthetics Society</span>
						<span class="text-gray-300 hidden sm:inline">|</span>
						<span class="text-gray-600">Co-President</span>
					</div>
					<span class="text-sm text-gray-400">2023 – Present</span>
				</div>
			</div>
		</section>

		<!-- ========== WANT TO SEE MORE? ========== -->
		<section class="mb-16 text-center">
			<h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-4">Want to see more?</h2>
			<div class="flex flex-col sm:flex-row items-center justify-center gap-4">
				<a
					href={googleDriveResumeLink}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-block bg-gray-800 text-white font-semibold px-6 py-2.5 rounded-xl shadow-sm hover:shadow-md hover:bg-gray-700 transition-all duration-300 text-sm"
				>
					View Resume
				</a>
				<a
					href="/resume"
					class="text-sm text-gray-500 hover:text-gray-800 transition-colors underline underline-offset-4"
				>
					Resume &amp; Links page →
				</a>
			</div>
		</section>

		<!-- ========== PROOF OF WORK-LIFE BALANCE (auto-scroll gallery) ========== -->
		<section class="mb-16">
			<h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-6 text-center">Proof of Work-Life Balance</h2>

			<!-- Scrolling gallery wrapper -->
			<div class="overflow-hidden">
				<div class="gallery-track flex gap-4" style="width: max-content;">
					<!-- Placeholder image slots — replace src with real images later -->
					{[1, 2, 3, 4, 5, 6, 7, 8].map((i) => (
						<div class="flex-shrink-0 w-64 h-48 rounded-2xl bg-gray-100 border border-gray-200 flex items-center justify-center">
							<span class="text-xs text-gray-400 font-medium">Photo {i}</span>
						</div>
					))}
					<!-- Duplicate set for seamless loop -->
					{[1, 2, 3, 4, 5, 6, 7, 8].map((i) => (
						<div class="flex-shrink-0 w-64 h-48 rounded-2xl bg-gray-100 border border-gray-200 flex items-center justify-center">
							<span class="text-xs text-gray-400 font-medium">Photo {i}</span>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- ========== IN MY HEADPHONES ========== -->
		<section class="mb-16">
			<h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-6 text-center">In My Headphones</h2>

			<div class="flex flex-col items-center gap-4">
				<!-- Song card -->
				<div class="flex items-center gap-4 bg-white rounded-2xl shadow-sm border border-gray-100 p-4 max-w-sm w-full">
					<!-- Album art placeholder -->
					<div class="flex-shrink-0 w-16 h-16 rounded-xl overflow-hidden bg-gray-100 border border-gray-200">
						<img src="/images/fleetwood.jpg" alt="Album art" class="w-full h-full object-cover" />
					</div>
					<div class="flex-1 min-w-0">
						<p class="text-base font-bold text-gray-800 truncate" style="margin-bottom: 0.1rem;">You Make Loving Fun</p>
						<p class="text-sm text-gray-400 truncate" style="margin-bottom: 0;">Fleetwood Mac</p>
					</div>
					<!-- Spotify button -->
					<a
						href={spotifyLink}
						target="_blank"
						rel="noopener noreferrer"
						class="flex-shrink-0 flex items-center gap-1.5 bg-green-500 hover:bg-green-600 text-white text-xs font-bold px-3 py-1.5 rounded-full transition-colors duration-200"
					>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.486 2 2 6.486 2 12s4.486 10 10 10 10-4.486 10-10S17.514 2 12 2zm4.535 14.507a.625.625 0 01-.856.186c-2.372-1.411-5.35-1.731-8.883-.949a.625.625 0 01-.748-.469.625.625 0 01.469-.748c3.85-.882 7.147-.518 9.83 1.096a.625.625 0 01.188.883zm1.206-2.68a.781.781 0 01-1.069.235c-2.711-1.666-6.851-2.148-10.072-1.175a.781.781 0 01-.954-.51.781.781 0 01.51-.955c3.538-1.081 7.975-.556 11.035 1.291a.781.781 0 01.234 1.067zm.11-2.789a.938.938 0 01-1.285.281c-3.072-1.888-8.066-2.441-11.886-1.333a.937.937 0 01-1.147-.608.937.937 0 01.609-1.148c4.167-1.272 9.584-.652 13.003 1.482a.938.938 0 01.288 1.28z"/></svg>
						Spotify
					</a>
				</div>
			</div>
		</section>

		<!-- ========== BOTTOM QUOTE ========== -->
		<div class="text-center py-10 border-t border-gray-100">
			<p class="text-sm text-gray-400 italic">
				This little corner of the internet is where I collect my thoughts about brains, code, and everything in between.
			</p>
			<div class="mt-3 w-12 h-0.5 bg-gradient-to-r from-transparent via-muted-rose to-transparent mx-auto opacity-50"></div>
		</div>
	</div>

	<!-- ========== GALLERY SCROLL ANIMATION ========== -->
	<style is:global>
		@keyframes scrollLeft {
			0% {
				transform: translateX(0);
			}
			100% {
				transform: translateX(-50%);
			}
		}

		.gallery-track {
			animation: scrollLeft 30s linear infinite;
		}
	</style>
</MainLayout>
