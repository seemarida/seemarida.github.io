---
import MainLayout from '../layouts/MainLayout.astro';
import { aboutContent } from '../data/aboutContent.ts';
import { siteConfig } from '../data/siteConfig.js';

const googleDriveResumeLink = "https://drive.google.com/file/d/1vMcm1Vrld1HCFTy2rBo5zAO5CgFo5NxH/view?usp=sharing";
const spotifyLink = "https://open.spotify.com/user/wyklimh7i9katv6ph7rwdc3oz?si=5cf2ec54d8db47da";
---

<MainLayout
	title={`${siteConfig.name} | About`}
	description={aboutContent.pageDescription}
>
	<div class="max-w-7xl mx-auto px-4 md:px-12 py-8">

		<!-- ========== HERO: Headshot left, bio right ========== -->
		<section class="flex flex-col md:flex-row items-start mb-16" style="gap: 3rem;">
			<!-- Headshot — pinned to left edge -->
			<div class="flex-shrink-0" style="margin-left: -1rem;">
				<div class="rounded-2xl overflow-hidden" style="width: 400px; aspect-ratio: 3/4; box-shadow: 0 6px 10px rgba(0,0,0,0.07);">
					<img src="/headshot.png" alt="Seema Rida" class="w-full h-full object-cover" />
				</div>
			</div>

			<!-- Bio -->
			<div class="flex-1">
				{aboutContent.profile.bio.map((paragraph, index) => (
					<p class="text-gray-700 leading-relaxed" style={index < aboutContent.profile.bio.length - 1 ? "margin-bottom: 1rem; font-size: 20px;" : "margin-bottom: 0; font-size: 20px;"}>
						{paragraph}
					</p>
				))}
			</div>
		</section>

		<!-- ========== SKILLS & EXPERIENCE ========== -->
		<section class="mb-10">
			<p class="text-gray-400 uppercase tracking-widest mb-2" style="font-weight: 400; letter-spacing: 0.2em; font-size: 14px;">Skills &amp; Experience</p>
			<hr class="border-gray-200 mb-5" />

			<div class="flex flex-col lg:flex-row gap-12">

				<!-- LEFT: Experience -->
				<div class="flex-1">
					<h2 class="text-gray-800" style="margin-bottom: 1rem; font-weight: 400; font-size: 28px;">Experience</h2>
					<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
						<!-- Undergraduate Researcher -->
						<div class="flex flex-col">
							<div class="w-full aspect-square bg-white rounded-xl border border-gray-200 flex items-center justify-center mb-3 p-4">
								<img src="https://cogsci.ucsd.edu/_images/department-images/brain-logo.png" alt="UCSD Cognitive Science" class="w-full h-full object-contain" />
							</div>
							<h3 class="text-gray-800" style="margin-bottom: 0.35rem; font-size: 16px; font-weight: 300;">Undergraduate Researcher</h3>
							<p class="text-gray-400" style="margin-bottom: 0; font-size: 14px; font-weight: 200;">Chiba Lab</p>
						</div>

						<!-- UC Scholar Research Fellow -->
						<div class="flex flex-col">
							<div class="w-full aspect-square bg-white rounded-xl border border-gray-200 flex items-center justify-center mb-3 p-4">
								<img src="https://ugresearch.ucsd.edu/_images/urh/UR_Design_Icon_Color_transparency.png" alt="Undergraduate Research Hub" class="w-full h-full object-contain" />
							</div>
							<h3 class="text-gray-800" style="margin-bottom: 0.35rem; font-size: 16px; font-weight: 300;">UC Scholar Research Fellow</h3>
							<p class="text-gray-400" style="margin-bottom: 0; font-size: 14px; font-weight: 200;">Undergraduate Research Hub</p>
						</div>

						<!-- Data Science Intern, Abwaab -->
						<div class="flex flex-col">
							<div class="w-full aspect-square bg-white rounded-xl border border-gray-200 flex items-center justify-center mb-3 p-4">
								<img src="https://t4.education/wp-content/uploads/2025/07/abwaab-main.png" alt="Abwaab" class="w-full h-full object-contain" />
							</div>
							<h3 class="text-gray-800" style="margin-bottom: 0.35rem; font-size: 16px; font-weight: 300;">Data Science Intern</h3>
							<p class="text-gray-400" style="margin-bottom: 0; font-size: 14px; font-weight: 200;">Abwaab</p>
						</div>

						<!-- Robotics Instructor -->
						<div class="flex flex-col">
							<div class="w-full aspect-square bg-white rounded-xl border border-gray-200 flex items-center justify-center mb-3 p-4">
								<img src="https://static1.squarespace.com/static/5901b9191b10e3a0176d6dc3/t/5919c1426a496322aac0c6f8/1494860100558/LogoDark.png?format=1500w" alt="International Robotics Academy" class="w-full h-full object-contain" />
							</div>
							<h3 class="text-gray-800" style="margin-bottom: 0.35rem; font-size: 16px; font-weight: 300;">Robotics Instructor</h3>
							<p class="text-gray-400" style="margin-bottom: 0; font-size: 14px; font-weight: 200;">International Robotics Academy</p>
						</div>
					</div>
				</div>

				<!-- RIGHT: Skills -->
				<div class="lg:w-72 flex-shrink-0">
					<h2 class="text-gray-800" style="margin-bottom: 1rem; font-weight: 400; font-size: 28px;">Skills</h2>

					<!-- Technical -->
					<div class="mb-4">
						<h3 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-2">Technical</h3>
						<div class="flex flex-wrap gap-2">
							{aboutContent.skills.techniques.items.map(skill => (
								<span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm border border-gray-200">{skill}</span>
							))}
						</div>
					</div>

					<!-- Research -->
					<div class="mb-4">
						<h3 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-2">Research</h3>
						<div class="flex flex-wrap gap-2">
							{aboutContent.skills.technologies.items.map(skill => (
								<span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm border border-gray-200">{skill}</span>
							))}
						</div>
					</div>
				</div>
			</div>

			<!-- Leadership — below Experience & Skills -->
			<div class="mt-8">
				<h2 class="text-gray-800" style="margin-bottom: 1rem; font-weight: 400; font-size: 28px;">Leadership</h2>
				<div class="space-y-3">
					<!-- Co-President, TPS -->
					<div class="flex justify-between items-start">
						<div>
							<p class="text-gray-800" style="margin-bottom: 0; font-size: 18px;">Tritons Prosthetic Society (TPS) <span class="text-gray-300 mx-1">|</span> <span class="text-gray-400">Co-President</span></p>
						</div>
						<p class="text-gray-300 flex-shrink-0 ml-4" style="font-size: 18px;">May 2025 - Present</p>
					</div>

					<!-- Peer Mentor, CSSA -->
					<div class="flex justify-between items-start">
						<div>
							<p class="text-gray-800" style="margin-bottom: 0; font-size: 18px;">Cognitive Science Student Association (CSSA) <span class="text-gray-300 mx-1">|</span> <span class="text-gray-400">Peer Mentor</span></p>
						</div>
						<p class="text-gray-300 flex-shrink-0 ml-4" style="font-size: 18px;">Nov 2022 - Present</p>
					</div>
				</div>
			</div>
		</section>

		<!-- ========== WANT TO SEE MORE? ========== -->
		<section class="mb-10 text-center">
			<h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-4">Want to see more?</h2>
			<a
				href={googleDriveResumeLink}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-block bg-gray-800 text-white font-semibold px-6 py-2.5 rounded-xl shadow-sm hover:shadow-md hover:bg-gray-700 transition-all duration-300 text-sm"
			>
				View Resume
			</a>
		</section>

	<!-- ========== IN MY HEADPHONES ========== -->
	<section class="mb-16">
		<p class="text-gray-400 uppercase tracking-widest mb-2" style="font-weight: 400; letter-spacing: 0.2em; font-size: 14px;">In My Headphones</p>
		<hr class="border-gray-200 mb-5" />

		<div class="flex flex-col items-start gap-4">
			<!-- Song card -->
			<div class="flex items-center gap-4 bg-white rounded-2xl shadow-sm border border-gray-100 p-4 max-w-sm w-full hover:shadow-md transition-all duration-300">
				<!-- Album art placeholder -->
				<div class="flex-shrink-0 w-16 h-16 rounded-xl overflow-hidden bg-gray-100 border border-gray-200">
					<img src="/images/fleetwood.jpg" alt="Album art" class="w-full h-full object-cover" />
				</div>
				<div class="flex-1 min-w-0">
					<p class="text-base font-bold text-gray-800 truncate" style="margin-bottom: 0.1rem;">You Make Loving Fun</p>
					<p class="text-sm text-gray-400 truncate" style="margin-bottom: 0;">Fleetwood Mac</p>
				</div>
				<!-- Spotify button -->
				<a
					href={spotifyLink}
					target="_blank"
					rel="noopener noreferrer"
					class="flex-shrink-0 flex items-center gap-1.5 bg-green-500 hover:bg-green-600 text-white text-xs font-bold px-3 py-1.5 rounded-full transition-colors duration-200"
				>
					<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.486 2 2 6.486 2 12s4.486 10 10 10 10-4.486 10-10S17.514 2 12 2zm4.535 14.507a.625.625 0 01-.856.186c-2.372-1.411-5.35-1.731-8.883-.949a.625.625 0 01-.748-.469.625.625 0 01.469-.748c3.85-.882 7.147-.518 9.83 1.096a.625.625 0 01.188.883zm1.206-2.68a.781.781 0 01-1.069.235c-2.711-1.666-6.851-2.148-10.072-1.175a.781.781 0 01-.954-.51.781.781 0 01.51-.955c3.538-1.081 7.975-.556 11.035 1.291a.781.781 0 01.234 1.067zm.11-2.789a.938.938 0 01-1.285.281c-3.072-1.888-8.066-2.441-11.886-1.333a.937.937 0 01-1.147-.608.937.937 0 01.609-1.148c4.167-1.272 9.584-.652 13.003 1.482a.938.938 0 01.288 1.28z"/></svg>
					Spotify
				</a>
			</div>
		</div>
	</section>

</MainLayout>
