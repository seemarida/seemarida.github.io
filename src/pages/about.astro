---
import SiteLayout from '../layouts/SiteLayout.astro';
import RetroWindow from '../components/RetroWindow.astro';
---

<SiteLayout title="about | Seema Rida">
  <style>
    main {
      max-width: 1200px;
      margin: 0 auto;
      padding: 4rem 2rem;
      min-height: calc(100vh - 200px);
    }

    .about-layout {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .bio-section {
      display: flex;
      gap: 2rem;
      align-items: center;
      max-width: 900px;
      margin: 0 auto;
    }

    .headshot-container {
      position: relative;
      border: 2px solid #E7E3DC;
      background: radial-gradient(circle, rgba(28, 25, 23, 0.02) 1px, transparent 1px);
      background-size: 12px 12px;
      padding: 1rem;
      flex-shrink: 0;
      width: 200px;
    }

    .headshot-container img {
      width: 100%;
      display: block;
      border: 2px solid #1C1917;
    }

    .content-section {
      font-family: 'Inter', sans-serif;
      font-size: 1rem;
      color: #1C1917;
      line-height: 1.6;
      flex: 1;
    }

    .content-section p {
      margin-bottom: 1.5rem;
    }

    .sections-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      margin-top: 2rem;
      justify-content: center;
      max-width: 900px;
      margin-left: auto;
      margin-right: auto;
    }

    .section-column {
      display: flex;
      flex-direction: column;
    }

    h2 {
      font-family: 'VT323', monospace;
      font-size: 1.5rem;
      font-weight: 400;
      color: #1C1917;
      margin: 0 0 1rem;
      border-bottom: 2px solid #1C1917;
      padding-bottom: 0.5rem;
    }

    .experience-list {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .experience-item {
      display: flex;
      gap: 1rem;
      border-left: 4px solid #E7E3DC;
      padding-left: 1rem;
      transition: border-color 0.2s;
    }

    .experience-item:hover {
      border-left-color: #6FAB84;
    }

    .experience-logo {
      flex-shrink: 0;
      width: 60px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid #1C1917;
      background: #F8F6F4;
      padding: 0.5rem;
    }

    .experience-logo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      filter: contrast(1.2);
      image-rendering: -webkit-optimize-contrast;
      image-rendering: crisp-edges;
    }

    .experience-content {
      flex: 1;
    }

    .experience-title {
      font-size: 1.125rem;
      color: #1C1917;
      margin-bottom: 0.25rem;
    }

    .experience-org {
      color: #6B7280;
      margin-bottom: 0.25rem;
    }

    .experience-date {
      color: #6FAB84;
      font-size: 1rem;
      margin-bottom: 0.5rem;
    }

    .experience-description {
      color: #1C1917;
      line-height: 1.7;
      font-size: 1rem;
    }

    @media (max-width: 768px) {
      main {
        padding: 3rem 1rem;
      }

      .bio-section {
        flex-direction: column;
        align-items: center;
      }

      .headshot-container {
        width: 180px;
      }

      .sections-container {
        grid-template-columns: 1fr;
        gap: 2rem;
      }

      .experience-logo {
        width: 50px;
        height: 50px;
      }
    }
  </style>

  <main>
    <RetroWindow title="about me.txt" backLink="/" backLabel="×">
      <div class="about-layout">
        <div class="bio-section">
          <div class="headshot-container">
            <img src="/headshot.png" alt="Seema Rida" />
          </div>

          <div class="content-section">
            <p>
              I'm a researcher interested in wearable tech, physiology, and behavior. I just graduated from UC San Diego with a B.S. in Cognitive Science (Machine Learning & Neural Computation) and a minor in Computer Science, and I'm now a research engineer at Stanford, working on neuromodulation and bioelectronic applications.
            </p>
            <p>
              Understanding how the brain and body work has always been more than academic for me. It's personal. Learning how my own brain works is part of what pulled me toward neuroscience and behavior in the first place. Outside of research, I enjoy photography, boxing, thrifting, and live music!
            </p>
          </div>
        </div>

        <div class="sections-container">
            <div class="section-column">
              <h2>experience</h2>
              <div class="experience-list">
            <div class="experience-item">
              <div class="experience-logo">
                <img src="/logos/stanford.png" alt="Stanford" />
              </div>
              <div class="experience-content">
                <div class="experience-title">Research Engineer</div>
                <div class="experience-org">Stanford Radiology</div>
                <div class="experience-date">Sep 2026 – Present</div>
              </div>
            </div>

            <div class="experience-item">
              <div class="experience-logo">
                <img src="/logos/ucsd.png" alt="UCSD" />
              </div>
              <div class="experience-content">
                <div class="experience-title">Undergraduate Researcher</div>
                <div class="experience-org">Chiba Lab · UCSD</div>
                <div class="experience-date">Oct 2024 – Sep 2026</div>
              </div>
            </div>

            <div class="experience-item">
              <div class="experience-logo">
                <img src="/logos/urh.png" alt="URH" />
              </div>
              <div class="experience-content">
                <div class="experience-title">UC Scholar</div>
                <div class="experience-org">Undergraduate Research Hub</div>
                <div class="experience-date">Jan 2025 – Jun 2026</div>
              </div>
            </div>

            <div class="experience-item">
              <div class="experience-logo">
                <img src="/logos/abwaab.png" alt="Abwaab" />
              </div>
              <div class="experience-content">
                <div class="experience-title">Data Science Intern</div>
                <div class="experience-org">Abwaab</div>
                <div class="experience-date">Jun 2024 – Sep 2024</div>
              </div>
            </div>

            <div class="experience-item">
              <div class="experience-logo">
                <img src="/logos/ira.png" alt="IRA" />
              </div>
              <div class="experience-content">
                <div class="experience-title">Robotics Instructor</div>
                <div class="experience-org">International Robotics Academy</div>
                <div class="experience-date">Jun 2022 – Aug 2023</div>
              </div>
            </div>
              </div>
            </div>

            <div class="section-column">
              <h2>leadership & teaching</h2>
              <div class="experience-list">
            <div class="experience-item">
              <div class="experience-logo">
                <img src="/logos/tps.png" alt="TPS" />
              </div>
              <div class="experience-content">
                <div class="experience-title">Co-President</div>
                <div class="experience-org">Tritons Prosthetic Society</div>
                <div class="experience-date">May 2025 – Jun 2026</div>
              </div>
            </div>

            <div class="experience-item">
              <div class="experience-logo">
                <img src="/logos/ucsd.png" alt="UCSD" />
              </div>
              <div class="experience-content">
                <div class="experience-title">Teaching Assistant</div>
                <div class="experience-org">Neural Signal Processing (COGS 118C)</div>
                <div class="experience-date">Jan 2026 – Jun 2026</div>
              </div>
            </div>

            <div class="experience-item">
              <div class="experience-logo">
                <img src="/logos/cssa.png" alt="CSSA" />
              </div>
              <div class="experience-content">
                <div class="experience-title">Peer Mentor</div>
                <div class="experience-org">Cognitive Science Student Association</div>
                <div class="experience-date">Nov 2022 – Jun 2026</div>
              </div>
            </div>
              </div>
            </div>
          </div>
      </div>
    </RetroWindow>
  </main>
</SiteLayout>
