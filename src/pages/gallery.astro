---
import SiteLayout from '../layouts/SiteLayout.astro';
import RetroWindow from '../components/RetroWindow.astro';

const photos = [
  'DSC01478.JPG',
  'BB2F8F6E-51EE-4B64-937C-F8C03F8C2A93.JPG',
  'DSC00263.JPG',
  'DSC00894.JPG',
  'F54E8E01-7708-4825-9F46-B9D6FFFA1ABF.JPG',
  'DSC02433.JPG',
  'DSC00210.JPG',
  '0638793D-97AE-4A1A-AE88-0D3F47599E98.JPG',
  'DSC01526.JPG',
  'DSC00675.JPG',
  'BFF87EA4-7104-4EE9-8B74-B3C171F90859.JPG',
  'DSC01318.JPG',
  'DSC00855.JPG',
  'DSC02537.JPG',
  '610C399C-10E4-49A2-BA89-3903894AD85D.JPG',
  'DSC00777.JPG',
