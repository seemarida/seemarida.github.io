---

<SiteLayout title="gallery | Seema Rida">
  <style>
    main {
      max-width: 1400px;
      margin: 0 auto;
      padding: 4rem 2rem;
      min-height: calc(100vh - 200px);
    }

    .gallery-intro {
      font-family: 'VT323', monospace;
      font-size: 1.125rem;
      color: #1C1917;
      line-height: 1.6;
      letter-spacing: 0.05em;
      margin-bottom: 2rem;
      text-align: center;
    }

    .gallery-grid {
      column-count: 3;
      column-gap: 1.5rem;
      margin-top: 2rem;
    }

    .photo-card {
      position: relative;
      break-inside: avoid;
      margin-bottom: 1.5rem;
      transition: transform 0.2s;
    }

    .photo-card:hover {
      transform: translateY(-4px);
    }

    .photo-container {
      position: relative;
      width: 100%;
      overflow: hidden;
      background: #F8F6F4;
    }

    .photo-container img {
      width: 100%;
      height: auto;
      display: block;
    }

    .photo-caption {
      font-family: 'VT323', monospace;
      font-size: 1rem;
      color: #1C1917;
      margin-top: 0.75rem;
      text-align: center;
      letter-spacing: 0.05em;
    }

    .placeholder-text {
      font-family: 'VT323', monospace;
      font-size: 1.125rem;
      color: #6B7280;
      text-align: center;
      padding: 3rem 2rem;
      line-height: 1.8;
    }

    @media (max-width: 1024px) {
      .gallery-grid {
        column-count: 2;
      }
    }

    @media (max-width: 768px) {
      main {
        padding: 3rem 1rem;
      }

      .gallery-grid {
        column-count: 1;
      }
    }
  </style>

  <main>
    <RetroWindow title="gallery" backLink="/" backLabel="×">
      <div class="gallery-intro">
        <p>seema's visual diary</p>
      </div>

      <div class="gallery-grid">
        {photos.map((photo) => (
          <div class="photo-card">
            <div class="photo-container">
              <img src={`/gallery/${photo}`} alt={`Photography by Seema Rida - ${photo}`} loading="lazy" />
            </div>
          </div>
        ))}
      </div>
    </RetroWindow>
  </main>
</SiteLayout>
