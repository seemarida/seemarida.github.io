---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import RetroWindow from '../../../components/RetroWindow.astro';
import { projects } from '../../../data/workData';

export async function getStaticPaths() {
  return projects.map(project => ({
    params: { project: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;

const oldResearchMapping = {
  'children-movement': 'biosensor-movement',
  'ppg-skin-tones': 'ppg-skin-tone',
  'eeg-attention': 'eeg-attention',
  'clip-illusions': 'optical-illusions-clip',
  'rnn-sarcasm': 'sarcastic-headlines',
  'icg-neural-correlations': 'icg-neural-correlations',
  'biosignal-pipeline': null
};

const oldPath = oldResearchMapping[project.slug];
const redirectUrl = oldPath ? `/research/${oldPath}` : `/projects/biosignal-pipeline`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content={`0; url=${redirectUrl}`} />
  <title>Redirecting...</title>
</head>
<body>
  <p>Redirecting to <a href={redirectUrl}>project details</a>...</p>
</body>
</html>
