---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import RetroWindow from '../../../components/RetroWindow.astro';
import { projects } from '../../../data/workData';

export async function getStaticPaths() {
  return projects.map(project => ({
    params: { project: project.shortName },
    props: { project }
  }));
}

const { project } = Astro.props;

const oldResearchMapping = {
  'movement_and_affect': 'biosensor-movement',
  'ppg_signal_accuracy': 'ppg-skin-tone',
  'eeg_and_attention': 'eeg-attention',
  'optical_illusions_in_clip': 'optical-illusions-clip',
  'rnns_and_satire': 'sarcastic-headlines',
  'multiscale_dynamics': 'icg-neural-correlations',
  'biosignal_pipeline': null
};

const oldPath = oldResearchMapping[project.shortName];
const redirectUrl = oldPath ? `/research/${oldPath}` : `/projects/biosignal-pipeline`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content={`0; url=${redirectUrl}`} />
  <title>Redirecting...</title>
</head>
<body>
  <p>Redirecting to <a href={redirectUrl}>project details</a>...</p>
</body>
</html>
