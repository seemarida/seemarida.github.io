---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import RetroWindow from '../../../components/RetroWindow.astro';
import { projects } from '../../../data/workData';

export async function getStaticPaths() {
  return projects.map(project => ({
    params: { project: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;

// Map to old research pages
const oldResearchMapping = {
  'children-movement': 'biosensor-movement',
  'ppg-skin-tones': 'ppg-skin-tone',
  'eeg-attention': 'eeg-attention',
  'clip-illusions': 'optical-illusions-clip',
  'rnn-sarcasm': 'sarcastic-headlines',
  'icg-neural-correlations': 'icg-neural-correlations'
};

const oldPath = oldResearchMapping[project.slug];
---

<SiteLayout title={`${project.label} | Seema Rida`}>
  <main>
    <RetroWindow
      title={`work / ${project.slug} / about.txt`}
      backLink={`/work/${project.slug}`}
      backLabel="close"
    >
      <div class="text-content">
        {oldPath && (
          <iframe src={`/research/${oldPath}`} class="content-frame"></iframe>
        )}
      </div>
    </RetroWindow>
  </main>

  <style>
    main {
      max-width: 1200px;
      margin: 0 auto;
      padding: 4rem 2rem;
      min-height: calc(100vh - 200px);
    }

    .text-content {
      background: #F8F6F4;
      border: 2px solid #1C1917;
      padding: 2rem;
      min-height: 400px;
      font-family: 'Inter', sans-serif;
      font-size: 1rem;
      line-height: 1.6;
      color: #1C1917;
    }

    .content-frame {
      width: 100%;
      min-height: 600px;
      border: none;
      background: #FAF8F5;
    }

    @media (max-width: 768px) {
      main {
        padding: 3rem 1rem;
      }

      .text-content {
        padding: 1.5rem;
      }
    }
  </style>
</SiteLayout>
