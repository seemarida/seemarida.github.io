---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { projects } from '../../data/workData';
---

<SiteLayout title="work | Seema Rida">
  <main>
    <h1>work</h1>
    <div class="desktop">
      {projects.map(project => {
        const itemCount = 1 + project.resources.length;
        return (
          <a href={`/work/${project.shortName}`} class="folder-link" aria-label={`view ${project.shortName} project`}>
            <div class="folder-icon-container">
              <svg viewBox="0 0 160 120" class="folder-icon" aria-hidden="true">
                <path
                  d="M 10 30 L 60 30 L 70 40 L 150 40 L 150 110 L 10 110 Z"
                  fill="#6FAB84"
                  stroke="#1C1917"
                  stroke-width="2"
                  shape-rendering="crispEdges"
                />
                <path
                  d="M 60 30 L 70 40 L 150 40"
                  fill="none"
                  stroke="#1C1917"
                  stroke-width="2"
                  shape-rendering="crispEdges"
                />
                <line
                  x1="10"
                  y1="45"
                  x2="150"
                  y2="45"
                  stroke="#1C1917"
                  stroke-width="1"
                  shape-rendering="crispEdges"
                />
              </svg>
            </div>
            <div class="folder-label">
              <span class="folder-name">{project.shortName.replace(/_/g, ' ')}</span>
              <span class="folder-count">{itemCount} item{itemCount === 1 ? '' : 's'}</span>
            </div>
          </a>
        );
      })}
    </div>
  </main>

  <style>
    main {
      max-width: 1200px;
      margin: 0 auto;
      padding: 4rem 2rem;
      min-height: calc(100vh - 200px);
    }

    h1 {
      font-family: 'Libre Baskerville', serif;
      font-size: 2.5rem;
      font-weight: 400;
      color: #1C1917;
      margin-bottom: 4rem;
      text-align: center;
    }

    .desktop {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 3rem 2rem;
      max-width: 900px;
      margin: 0 auto;
      justify-content: center;
    }

    .folder-link {
      text-decoration: none;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      outline: none;
      padding: 0.5rem;
    }

    .folder-icon-container {
      position: relative;
      width: 120px;
      height: 90px;
    }

    .folder-link:hover .folder-icon-container,
    .folder-link:focus .folder-icon-container {
      outline: 2px dotted #1C1917;
      outline-offset: 4px;
    }

    .folder-icon {
      width: 100%;
      height: 100%;
    }

    .folder-label {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.125rem;
      padding: 0.25rem 0.75rem;
      transition: none;
      max-width: 100%;
    }

    @media (prefers-reduced-motion: no-preference) {
      .folder-link:hover .folder-label,
      .folder-link:focus .folder-label {
        animation: invertLabel 0.1s steps(1) forwards;
      }
    }

    @keyframes invertLabel {
      to {
        background: #1C1917;
      }
    }

    .folder-link:hover .folder-label,
    .folder-link:focus .folder-label {
      background: #1C1917;
    }

    .folder-name {
      font-family: 'VT323', monospace;
      font-size: 1.125rem;
      color: #1C1917;
      text-align: center;
      line-height: 1.2;
      letter-spacing: 0.05em;
      word-wrap: break-word;
      max-width: 100%;
    }

    .folder-link:hover .folder-name,
    .folder-link:focus .folder-name {
      color: #F8F6F4;
    }

    .folder-count {
      font-family: 'VT323', monospace;
      font-size: 0.9375rem;
      color: #6B7280;
      line-height: 1.2;
      letter-spacing: 0.05em;
    }

    .folder-link:hover .folder-count,
    .folder-link:focus .folder-count {
      color: #E7E3DC;
    }

    .folder-link:focus {
      outline: 2px solid #6FAB84;
      outline-offset: 8px;
    }

    @media (max-width: 768px) {
      main {
        padding: 3rem 1.5rem;
      }

      h1 {
        font-size: 2rem;
        margin-bottom: 3rem;
      }

      .desktop {
        grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
        gap: 2.5rem 1.5rem;
      }

      .folder-icon-container {
        width: 110px;
        height: 82.5px;
      }
    }

    @media (max-width: 480px) {
      .desktop {
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        gap: 2rem 1rem;
      }

      .folder-icon-container {
        width: 100px;
        height: 75px;
      }

      .folder-name {
        font-size: 1rem;
      }

      .folder-count {
        font-size: 0.875rem;
      }
    }
  </style>
</SiteLayout>
