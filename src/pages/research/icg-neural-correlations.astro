---
const title = "Iterative Coarse-Graining of Neural Correlations";
const description = "Understanding multiscale neural structure by implementing the ICG algorithm from Munn et al., Cell 187, 7303–7313 (2024).";
const tags = ["Neuroscience", "Computational Neuroscience", "Neural Correlations", "Multiscale Analysis", "Python"];
---

