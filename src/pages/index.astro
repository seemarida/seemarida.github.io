---
import SiteLayout from '../layouts/SiteLayout.astro';
import RetroWindow from '../components/RetroWindow.astro';
---

<SiteLayout>
  <style>
    /* Desktop Layout */
    .desktop {
      display: flex;
      padding: 4rem 0;
      gap: 2rem;
      align-items: start;
      min-height: calc(100vh - 200px);
    }

    .desktop-icons {
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
      padding-left: 24px;
      padding-top: 1rem;
      flex-shrink: 0;
    }

    .desktop-icon {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      text-decoration: none;
      padding: 0;
    }

    .icon-svg {
      width: 72px;
      height: 72px;
    }

    .icon-label {
      font-family: 'VT323', monospace;
      font-size: 1rem;
      color: #1C1917;
      text-align: center;
      line-height: 1.2;
      letter-spacing: 0.05em;
      padding: 0.25rem 0.5rem;
      max-width: 100%;
      transition: none;
    }

    @media (prefers-reduced-motion: no-preference) {
      .desktop-icon:hover .icon-label,
      .desktop-icon:focus .icon-label {
        animation: invertLabel 0.1s steps(1) forwards;
      }
    }

    @keyframes invertLabel {
      to {
        background: #1C1917;
        color: #F8F6F4;
      }
    }

    .desktop-icon:hover .icon-label,
    .desktop-icon:focus .icon-label {
      background: #1C1917;
      color: #F8F6F4;
    }

    .desktop-icon:focus {
      outline: 2px dotted #1C1917;
      outline-offset: 4px;
    }

    /* Main Content */
    .container {
      display: flex;
      justify-content: center;
      align-items: center;
      flex: 1;
      padding-right: 2rem;
    }

    .hero-wrapper {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      width: 100%;
    }

    .hero-section {
      display: flex;
      align-items: flex-start;
      gap: 2rem;
      width: 100%;
    }

    .left-section {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      flex-shrink: 0;
    }

    .image-panel {
      background: radial-gradient(circle, rgba(28, 25, 23, 0.02) 1px, transparent 1px);
      background-size: 12px 12px;
      padding: 1.5rem;
      border: 2px solid #E7E3DC;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    .image-container {
      position: relative;
      display: inline-block;
    }

    @media (prefers-reduced-motion: no-preference) {
      .image-container {
        animation: levitate 2s steps(4) infinite;
      }
    }

    .image-container img {
      width: 180px;
      height: 232px;
      object-fit: cover;
      display: block;
    }

    @keyframes levitate {
      0%, 100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-8px);
      }
    }

    .speech-bubble {
      position: relative;
      background: #FFFFFF;
      border: 2px solid #1C1917;
      box-shadow: 3px 3px 0 #1C1917;
      padding: 0.5rem 1rem;
      font-family: 'VT323', monospace;
      font-size: 1.125rem;
      color: #1C1917;
      letter-spacing: 0.05em;
    }

    .speech-bubble::before {
      content: '';
      position: absolute;
      top: -8px;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 0;
      border-left: 8px solid transparent;
      border-right: 8px solid transparent;
      border-bottom: 8px solid #1C1917;
    }

    .speech-bubble::after {
      content: '';
      position: absolute;
      top: -4px;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 0;
      border-left: 6px solid transparent;
      border-right: 6px solid transparent;
      border-bottom: 6px solid #FFFFFF;
    }

    .right-section {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      flex: 1;
    }

    .intro-line {
      font-family: 'VT323', monospace;
      font-size: 1.125rem;
      color: #1C1917;
      letter-spacing: 0.05em;
    }

    .intro-line .highlight {
      background: #6FAB84;
      color: #F8F6F4;
      padding: 0 0.25rem;
    }

    .main-title {
      font-family: 'Pixelify Sans', cursive;
      font-weight: 700;
      line-height: 1.1;
      color: #1C1917;
    }

    .main-title .sensors {
      font-size: 3.5rem;
    }

    .main-title .signals {
      font-size: 2.75rem;
    }

    .main-title .brain {
      font-size: 1.75rem;
      display: inline;
    }

    .blinking-cursor {
      display: inline-block;
      width: 0.75rem;
      height: 1.75rem;
      background: #1C1917;
      margin-left: 0.25rem;
      vertical-align: text-bottom;
    }

    @media (prefers-reduced-motion: no-preference) {
      .blinking-cursor {
        animation: blink 1s steps(2) infinite;
      }
    }

    @keyframes blink {
      50% {
        opacity: 0;
      }
    }

    .bio {
      font-family: 'VT323', monospace;
      font-size: 1.125rem;
      color: #1C1917;
      line-height: 1.6;
      letter-spacing: 0.05em;
    }

    .cta-section {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .cta-text {
      font-family: 'VT323', monospace;
      font-size: 1.125rem;
      color: #1C1917;
      letter-spacing: 0.05em;
    }

    .cta-buttons {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .retro-btn {
      font-family: 'VT323', monospace;
      font-size: 1rem;
      padding: 0.5rem 1rem;
      background: #F8F6F4;
      border: 2px solid #1C1917;
      box-shadow: 4px 4px 0 #1C1917;
      color: #1C1917;
      text-decoration: none;
      letter-spacing: 0.05em;
      cursor: pointer;
      transition: none;
      display: inline-block;
    }

    @media (prefers-reduced-motion: no-preference) {
      .retro-btn:hover {
        background: #6FAB84;
        animation: buttonPress 0.1s steps(1);
      }

      .retro-btn:active {
        transform: translate(2px, 2px);
        box-shadow: 2px 2px 0 #1C1917;
      }
    }

    .retro-btn:hover {
      background: #6FAB84;
    }

    .retro-btn:active {
      transform: translate(2px, 2px);
      box-shadow: 2px 2px 0 #1C1917;
    }

    .retro-btn:focus {
      outline: none;
      background: #1C1917;
      color: #F8F6F4;
    }

    @keyframes buttonPress {
      to {
        transform: translate(2px, 2px);
        box-shadow: 2px 2px 0 #1C1917;
      }
    }

    @media (max-width: 768px) {
      .desktop {
        flex-direction: column;
        padding: 3rem 1rem;
      }

      .desktop-icons {
        flex-direction: row;
        justify-content: center;
        gap: 2rem;
        padding-left: 0;
        padding-top: 0;
        order: 2;
      }

      .container {
        order: 1;
        padding-right: 0;
      }

      .hero-section {
        flex-direction: column;
        gap: 1.5rem;
        align-items: center;
      }

      .main-title .sensors {
        font-size: 2.5rem;
      }

      .main-title .signals {
        font-size: 2rem;
      }

      .main-title .brain {
        font-size: 1.5rem;
      }

      .blinking-cursor {
        width: 0.5rem;
        height: 1.5rem;
      }

      .cta-buttons {
        flex-direction: column;
      }

      .retro-btn {
        text-align: center;
      }
    }
  </style>

  <!-- Main Content -->
  <div class="desktop">
    <!-- Desktop Icons -->
    <div class="desktop-icons">
      <a href="/projects" class="desktop-icon">
        <svg viewBox="0 0 80 80" class="icon-svg" aria-hidden="true">
          <path d="M 10 20 L 40 20 L 45 25 L 70 25 L 70 65 L 10 65 Z"
            fill="#6FAB84" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
          <line x1="10" y1="30" x2="70" y2="30" stroke="#1C1917" stroke-width="1" shape-rendering="crispEdges" />
        </svg>
        <span class="icon-label">projects</span>
      </a>

      <a href="/about" class="desktop-icon">
        <svg viewBox="0 0 80 80" class="icon-svg" aria-hidden="true">
          <path d="M 15 10 L 15 70 L 65 70 L 65 25 L 50 10 Z"
            fill="#F8F6F4" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
          <path d="M 50 10 L 50 25 L 65 25"
            fill="#E7E3DC" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
          <line x1="25" y1="35" x2="55" y2="35" stroke="#6FAB84" stroke-width="2" shape-rendering="crispEdges" />
          <line x1="25" y1="45" x2="55" y2="45" stroke="#6FAB84" stroke-width="2" shape-rendering="crispEdges" />
          <line x1="25" y1="55" x2="45" y2="55" stroke="#6FAB84" stroke-width="2" shape-rendering="crispEdges" />
        </svg>
        <span class="icon-label">about me.txt</span>
      </a>

      <a href="/resume" class="desktop-icon">
        <svg viewBox="0 0 80 80" class="icon-svg" aria-hidden="true">
          <path d="M 15 10 L 15 70 L 65 70 L 65 25 L 50 10 Z"
            fill="#F8F6F4" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
          <path d="M 50 10 L 50 25 L 65 25"
            fill="#E7E3DC" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
          <rect x="20" y="30" width="40" height="35" fill="#6FAB84" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
          <text x="40" y="52" font-family="VT323, monospace" font-size="14" fill="#F8F6F4" text-anchor="middle">PDF</text>
        </svg>
        <span class="icon-label">resume.pdf</span>
      </a>
    </div>

    <div class="container">
    <RetroWindow title="welcome.exe" backLabel="">
      <div class="hero-wrapper">
        <div class="hero-section">
          <!-- Left Section: Image with Speech Bubble -->
          <div class="left-section">
            <div class="image-panel">
              <div class="image-container">
                <img src="/home_drawing.jpg" alt="Seema's illustration" />
              </div>
              <div class="speech-bubble">hi, i'm seema!</div>
            </div>
          </div>

          <!-- Right Section: Content -->
          <div class="right-section">
            <div class="intro-line">
              <span class="highlight">cogSci researcher</span> exploring
            </div>

            <div class="main-title">
              <div class="sensors">Sensors,</div>
              <div class="signals">Signals,</div>
              <div class="brain">& the Brain<span class="blinking-cursor" aria-hidden="true"></span></div>
            </div>

            <div class="bio">
              I'm a project research engineer at Stanford working on neuromodulation and bioelectronics. Originally from Amman, now in the Bay Area.
            </div>

            <div class="cta-section">
              <div class="cta-text">welcome to my website! click the icons on the left, or start here:</div>
              <div class="cta-buttons">
                <a href="/projects" class="retro-btn">browse projects</a>
                <a href="/about" class="retro-btn">about me</a>
                <a href="/resume" class="retro-btn">resume</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </RetroWindow>
    </div>
  </div>
</SiteLayout>
