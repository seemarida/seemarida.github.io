---
import MainLayout from '../layouts/MainLayout.astro';
import { homeContent } from '../data/homeContent.ts';
import { siteConfig } from '../data/siteConfig.js';
---

<MainLayout
	title={`${siteConfig.name} | Home`}
	description={siteConfig.description}
>
	<!-- ========== HERO ========== -->
	<section class="hero-section min-h-[50vh] flex flex-col md:flex-row items-center justify-between gap-8 px-4 md:px-8 py-16 max-w-6xl mx-auto">
		<!-- Left: Name + tagline -->
		<div class="flex-1 flex flex-col items-start md:items-start text-center md:text-left">
			<h1 class="text-5xl md:text-7xl font-bold text-gray-800 leading-tight mb-3" style="margin-bottom: 0.5rem;">
				Seema Rida
			</h1>
			<p class="text-xl md:text-2xl text-muted-rose font-light tracking-wide">
				cognitive science &amp; machine learning
			</p>
		</div>

		<!-- Right: Brain + signal processing SVG graphic -->
		<div class="flex-1 flex items-center justify-center">
			<svg viewBox="0 0 420 320" width="420" height="320" class="w-full max-w-md md:max-w-lg" xmlns="http://www.w3.org/2000/svg">
				<defs>
					<linearGradient id="brainGrad" x1="0%" y1="0%" x2="100%" y2="100%">
						<stop offset="0%" style="stop-color:#b39ddb;stop-opacity:0.9" />
						<stop offset="100%" style="stop-color:#7e57c2;stop-opacity:0.7" />
					</linearGradient>
					<linearGradient id="waveGrad" x1="0%" y1="0%" x2="100%" y2="0%">
						<stop offset="0%" style="stop-color:#b39ddb;stop-opacity:0.3" />
						<stop offset="50%" style="stop-color:#7e57c2;stop-opacity:0.8" />
						<stop offset="100%" style="stop-color:#b39ddb;stop-opacity:0.3" />
					</linearGradient>
					<filter id="glow">
						<feGaussianBlur stdDeviation="2" result="blur" />
						<feMerge>
							<feMergeNode in="blur" />
							<feMergeNode in="SourceGraphic" />
						</feMerge>
					</filter>
				</defs>

				<!-- Brain silhouette (simplified organic shape) -->
				<g opacity="0.12">
					<ellipse cx="210" cy="140" rx="95" ry="80" fill="#7e57c2" />
					<ellipse cx="170" cy="130" rx="60" ry="65" fill="#7e57c2" />
					<ellipse cx="250" cy="130" rx="60" ry="65" fill="#7e57c2" />
					<ellipse cx="210" cy="105" rx="70" ry="40" fill="#7e57c2" />
				</g>

				<!-- Neural nodes -->
				<circle cx="120" cy="100" r="5" fill="url(#brainGrad)" filter="url(#glow)" />
				<circle cx="160" cy="70"  r="4" fill="url(#brainGrad)" filter="url(#glow)" />
				<circle cx="210" cy="55"  r="5.5" fill="url(#brainGrad)" filter="url(#glow)" />
				<circle cx="260" cy="72"  r="4" fill="url(#brainGrad)" filter="url(#glow)" />
				<circle cx="300" cy="100" r="5" fill="url(#brainGrad)" filter="url(#glow)" />
				<circle cx="145" cy="140" r="4.5" fill="url(#brainGrad)" filter="url(#glow)" />
				<circle cx="275" cy="138" r="4.5" fill="url(#brainGrad)" filter="url(#glow)" />
				<circle cx="210" cy="135" r="6" fill="url(#brainGrad)" filter="url(#glow)" />
				<circle cx="180" cy="105" r="3.5" fill="url(#brainGrad)" filter="url(#glow)" />
				<circle cx="240" cy="108" r="3.5" fill="url(#brainGrad)" filter="url(#glow)" />
				<circle cx="155" cy="165" r="3.5" fill="url(#brainGrad)" filter="url(#glow)" opacity="0.7" />
				<circle cx="265" cy="163" r="3.5" fill="url(#brainGrad)" filter="url(#glow)" opacity="0.7" />

				<!-- Neural connections (synapses) -->
				<g stroke="url(#brainGrad)" stroke-width="1.2" fill="none" opacity="0.45">
					<line x1="120" y1="100" x2="160" y2="70" />
					<line x1="120" y1="100" x2="145" y2="140" />
					<line x1="160" y1="70"  x2="210" y2="55" />
					<line x1="160" y1="70"  x2="180" y2="105" />
					<line x1="210" y1="55"  x2="260" y2="72" />
					<line x1="260" y1="72"  x2="300" y2="100" />
					<line x1="260" y1="72"  x2="240" y2="108" />
					<line x1="300" y1="100" x2="275" y2="138" />
					<line x1="145" y1="140" x2="210" y2="135" />
					<line x1="210" y1="135" x2="275" y2="138" />
					<line x1="180" y1="105" x2="210" y2="135" />
					<line x1="240" y1="108" x2="210" y2="135" />
					<line x1="180" y1="105" x2="210" y2="55"  />
					<line x1="240" y1="108" x2="210" y2="55"  />
					<line x1="145" y1="140" x2="155" y2="165" />
					<line x1="275" y1="138" x2="265" y2="163" />
					<line x1="210" y1="135" x2="155" y2="165" />
					<line x1="210" y1="135" x2="265" y2="163" />
				</g>

				<!-- EEG / Signal wave at bottom -->
				<g filter="url(#glow)">
					<!-- Flat lead-in -->
					<polyline points="30,255 60,255 80,255" fill="none" stroke="url(#waveGrad)" stroke-width="2" stroke-linecap="round" />
					<!-- Active EEG burst -->
					<polyline points="80,255 92,255 100,240 108,270 116,225 124,275 132,230 140,268 148,238 156,260 164,242 172,265 180,245 188,258 196,248 204,260 212,242 220,258" fill="none" stroke="url(#waveGrad)" stroke-width="2.2" stroke-linecap="round" />
					<!-- Tapering off -->
					<polyline points="220,258 230,252 240,255 260,255 290,255 320,255 350,255 380,255" fill="none" stroke="url(#waveGrad)" stroke-width="2" stroke-linecap="round" />
				</g>

				<!-- Small label dots on the wave for realism -->
				<circle cx="100" cy="240" r="2" fill="#7e57c2" opacity="0.6" />
				<circle cx="116" cy="225" r="2" fill="#7e57c2" opacity="0.6" />
				<circle cx="132" cy="230" r="2" fill="#7e57c2" opacity="0.6" />
				<circle cx="148" cy="238" r="2" fill="#7e57c2" opacity="0.6" />
				<circle cx="164" cy="242" r="2" fill="#7e57c2" opacity="0.6" />

				<!-- Animated pulse dots on select nodes -->
				<circle cx="210" cy="55" r="3" fill="#b39ddb" opacity="0">
					<animate attributeName="opacity" values="0;0.6;0" dur="2.4s" repeatCount="indefinite" />
					<animate attributeName="r" values="3;7;3" dur="2.4s" repeatCount="indefinite" />
				</circle>
				<circle cx="210" cy="135" r="3" fill="#b39ddb" opacity="0">
					<animate attributeName="opacity" values="0;0.5;0" dur="2.8s" repeatCount="indefinite" begin="0.8s" />
					<animate attributeName="r" values="3;6;3" dur="2.8s" repeatCount="indefinite" begin="0.8s" />
				</circle>
				<circle cx="120" cy="100" r="2.5" fill="#b39ddb" opacity="0">
					<animate attributeName="opacity" values="0;0.5;0" dur="3s" repeatCount="indefinite" begin="1.6s" />
					<animate attributeName="r" values="2.5;5.5;2.5" dur="3s" repeatCount="indefinite" begin="1.6s" />
				</circle>
				<circle cx="300" cy="100" r="2.5" fill="#b39ddb" opacity="0">
					<animate attributeName="opacity" values="0;0.5;0" dur="2.6s" repeatCount="indefinite" begin="0.4s" />
					<animate attributeName="r" values="2.5;5.5;2.5" dur="2.6s" repeatCount="indefinite" begin="0.4s" />
				</circle>
			</svg>
		</div>
	</section>

	<!-- ========== PROJECTS GRID ========== -->
	<section class="projects-section max-w-6xl mx-auto px-4 md:px-8 pb-20">
		<h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-10 text-center" style="margin-bottom: 2.5rem;">projects</h2>

		<div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
			{homeContent.projects.map((project) => (
				<a
					href={`/projects/${project.slug}`}
					class="project-card-link group block bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 border border-gray-100 hover:border-muted-rose/40 overflow-hidden"
				>
					<!-- Image / placeholder -->
					<div class="project-img-wrap relative overflow-hidden bg-gray-100" style="aspect-ratio: 16/9;">
						{project.image ? (
							<img
								src={project.image}
								alt={project.title}
								class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
							/>
						) : (
							<div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-muted-rose/10 to-purple-100">
								<svg class="w-16 h-16 text-muted-rose opacity-50 transition-transform duration-500 group-hover:scale-110" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
								</svg>
							</div>
						)}
						<!-- Hover overlay -->
						<div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300 flex items-end">
							<span class="text-white text-sm font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-4">
								View project →
							</span>
						</div>
					</div>

					<!-- Text -->
					<div class="p-5">
						<h3 class="text-lg font-bold text-gray-800 group-hover:text-muted-rose transition-colors mb-1" style="margin-bottom: 0.35rem;">{project.title}</h3>
						<p class="text-sm text-gray-600 leading-relaxed" style="margin-bottom: 0;">{project.description}</p>
					</div>
				</a>
			))}
		</div>
	</section>

	<!-- ========== BOTTOM QUOTE ========== -->
	<div class="max-w-2xl mx-auto text-center pb-16 px-4">
		<p class="text-sm text-gray-400 italic">
			This little corner of the internet is where I collect my thoughts about brains, code, and everything in between.
		</p>
		<div class="mt-3 w-12 h-0.5 bg-gradient-to-r from-transparent via-muted-rose to-transparent mx-auto opacity-50"></div>
	</div>
</MainLayout>
