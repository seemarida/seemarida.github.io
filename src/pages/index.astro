              </div>
            </div>

            <div class="experience-item">
              <div class="experience-logo">
                <img src="/logos/cssa.png" alt="CSSA" />
              </div>
              <div class="experience-content">
                <div class="experience-title">Peer Mentor</div>
                <div class="experience-org">Cognitive Science Student Association</div>
                <div class="experience-date">Nov 2022 – Jun 2026</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Custom cursor follower
    const cursor = document.querySelector('.cursor');

    document.addEventListener('mousemove', (e) => {
      cursor.style.left = e.clientX + 'px';
      cursor.style.top = e.clientY + 'px';
    });

    // Navigation bar show/hide on scroll
    const nav = document.querySelector('nav');
    let lastScrollTop = 0;
    let scrollThreshold = 100; // Minimum scroll distance to trigger hide/show

    window.addEventListener('scroll', () => {
      let scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (Math.abs(scrollTop - lastScrollTop) > scrollThreshold) {
        if (scrollTop > lastScrollTop && scrollTop > 200) {
          // Scrolling down & past threshold
          nav.classList.add('hidden');
        } else {
          // Scrolling up
          nav.classList.remove('hidden');
        }
        lastScrollTop = scrollTop;
      }
    });

    // Image tooltip follower
    const imageContainer = document.querySelector('.image-container');
    const tooltip = document.querySelector('.image-tooltip');

    imageContainer.addEventListener('mousemove', (e) => {
      const rect = imageContainer.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      tooltip.style.left = x + 'px';
      tooltip.style.top = y + 'px';
      tooltip.style.transform = 'translate(-50%, -50%)';
    });

    // Research card tooltips follower
    const researchCards = document.querySelectorAll('.research-card');

    researchCards.forEach(card => {
      const cardTooltip = card.querySelector('.card-tooltip');

      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        cardTooltip.style.left = x + 'px';
        cardTooltip.style.top = y + 'px';
        cardTooltip.style.transform = 'translate(-50%, -50%)';
      });
    });

    // Headshot tooltip follower
    const headshotContainer = document.querySelector('.headshot-container');
    const headshotTooltip = document.querySelector('.headshot-tooltip');

    if (headshotContainer && headshotTooltip) {
      headshotContainer.addEventListener('mousemove', (e) => {
        const rect = headshotContainer.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        headshotTooltip.style.left = x + 'px';
        headshotTooltip.style.top = y + 'px';
        headshotTooltip.style.transform = 'translate(-50%, -50%)';
      });
    }
  </script>
</body>
</html>
