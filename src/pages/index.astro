---
import SiteLayout from '../layouts/SiteLayout.astro';
import RetroWindow from '../components/RetroWindow.astro';
---

<SiteLayout>
  <style>
    /* Main Content */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 4rem 2rem;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: calc(100vh - 200px);
    }

    .hero-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2rem;
      width: 100%;
    }

    .hero-section {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      gap: 51px;
      width: 100%;
      position: relative;
    }

    .left-section {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
    }

    .greeting {
      font-family: 'Nanum Pen Script', cursive;
      font-size: 32px;
      margin-bottom: 1rem;
      color: #1C1917;
      align-self: center;
    }

    .image-container {
      position: relative;
      display: inline-block;
    }

    @media (prefers-reduced-motion: no-preference) {
      .image-container {
        animation: levitate 2s steps(4) infinite;
      }
    }

    .image-container img {
      width: 195px;
      height: 252px;
      object-fit: cover;
    }

    @keyframes levitate {
      0%, 100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-10px);
      }
    }

    .right-section {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
    }

    .subtitle {
      font-family: 'Nanum Pen Script', cursive;
      font-size: 32px;
      color: #1C1917;
      margin-bottom: 0;
    }

    .subtitle .highlight {
      color: #6FAB84;
    }

    .main-title {
      font-family: 'Libre Baskerville', serif;
      font-weight: 400;
      line-height: 1;
      color: #1C1917;
      text-align: left;
      margin-top: 35px;
    }

    .main-title .sensors {
      font-size: 75px;
      margin-bottom: 27px;
    }

    .main-title .signals {
      font-size: 55px;
      margin-bottom: 27px;
    }

    .main-title .brain {
      font-size: 32px;
    }

    .bio {
      font-size: 1rem;
      font-family: 'Inter', sans-serif;
      font-weight: 300;
      color: #6B7280;
      line-height: 1.7;
      max-width: 750px;
      text-align: center;
    }

    @media (max-width: 768px) {
      .hero-section {
        flex-direction: column;
        gap: 2rem;
        align-items: center;
      }

      .main-title .sensors {
        font-size: 50px;
      }

      .main-title .signals {
        font-size: 40px;
      }

      .main-title .brain {
        font-size: 24px;
      }

      .container {
        padding: 3rem 1rem;
      }

      .bio {
        text-align: center;
      }
    }
  </style>

  <!-- Main Content -->
  <div class="container">
    <RetroWindow title="hi, i'm seema" backLabel="">
      <div class="hero-wrapper">
        <div class="hero-section">
          <!-- Left Section: Greeting + Image -->
          <div class="left-section">
            <div class="greeting">Hi. I'm Seema</div>
            <div class="image-container">
              <img src="/home_drawing.jpg" alt="Seema's illustration" />
            </div>
          </div>

          <!-- Right Section: Title -->
          <div class="right-section">
            <div class="subtitle">
              <span class="highlight">CogSci researcher</span> exploring
            </div>
            <div class="main-title">
              <div class="sensors">Sensors,</div>
              <div class="signals">Signals,</div>
              <div class="brain">& the Brain</div>
            </div>
          </div>
        </div>

        <!-- Bio Section -->
        <div class="bio">
          I build technology to understand physiology and behavior. Originally from Amman, now in the Bay Area working on wearable biosensing and bioelectronics research at Stanford.
        </div>
      </div>
    </RetroWindow>
  </div>
</SiteLayout>
