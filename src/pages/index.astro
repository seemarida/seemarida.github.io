---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout>
  <style>
    /* Main Content */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1rem 2rem 4rem 2rem;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: calc(100vh - 150px);
    }

    .hero-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2rem;
      width: 100%;
    }

    .hero-section {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      gap: 51px;
      width: 100%;
      position: relative;
    }

    .hero-section::after {
      content: '';
      position: absolute;
      left: 50%;
      top: 0;
      height: 100%;
      width: 1px;
      background: transparent;
      transform: translateX(-25.5px);
      pointer-events: none;
    }

    .left-section {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
    }

    .greeting {
      font-family: 'Nanum Pen Script', cursive;
      font-size: 32px;
      margin-bottom: 1rem;
      color: #1C1917;
      align-self: center;
    }

    .image-container {
      animation: levitate 2s ease-in-out infinite;
      position: relative;
      display: inline-block;
    }

    .image-container img {
      width: 195px;
      height: 252px;
      object-fit: cover;
    }

    .image-tooltip {
      position: absolute;
      background: rgba(229, 231, 235, 0.95);
      color: #6B7280;
      padding: 6px 14px;
      border-radius: 20px;
      font-family: 'Inter', sans-serif;
      font-size: 0.85rem;
      font-weight: 400;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      white-space: nowrap;
      z-index: 10;
    }

    .image-container:hover .image-tooltip {
      opacity: 1;
    }

    @keyframes levitate {
      0%, 100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-10px);
      }
    }

    .right-section {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
    }

    .subtitle {
      font-family: 'Nanum Pen Script', cursive;
      font-size: 32px;
      color: #1C1917;
      margin-bottom: 0;
    }

    .subtitle .highlight {
      color: #6FAB84;
    }

    .main-title {
      font-family: 'Libre Baskerville', serif;
      font-weight: 400;
      line-height: 1;
      color: #1C1917;
      text-align: left;
      margin-top: 35px;
    }

    .main-title .sensors {
      font-size: 75px;
      margin-bottom: 27px;
    }

    .main-title .signals {
      font-size: 55px;
      margin-bottom: 27px;
    }

    .main-title .brain {
      font-size: 32px;
    }

    .bio {
      font-size: 1rem;
      font-family: 'Inter', sans-serif;
      font-weight: 300;
      color: #6B7280;
      line-height: 1.7;
      max-width: 750px;
      text-align: center;
    }

    @media (max-width: 768px) {
      .hero-section {
        flex-direction: column;
        gap: 2rem;
        align-items: center;
      }

      .main-title .sensors {
        font-size: 50px;
      }

      .main-title .signals {
        font-size: 40px;
      }

      .main-title .brain {
        font-size: 24px;
      }

      .container {
        padding: 2rem 1rem;
      }

      .bio {
        text-align: center;
      }
    }
  </style>

  <!-- Main Content -->
  <div class="container">
    <div class="hero-wrapper">
      <div class="hero-section">
        <!-- Left Section: Greeting + Image -->
        <div class="left-section">
          <div class="greeting">Hi. I'm Seema</div>
          <div class="image-container">
            <img src="/home_drawing.jpg" alt="Seema's illustration" />
            <div class="image-tooltip">welcome :)</div>
          </div>
        </div>

        <!-- Right Section: Title -->
        <div class="right-section">
          <div class="subtitle">
            <span class="highlight">CogSci researcher</span> exploring
          </div>
          <div class="main-title">
            <div class="sensors">Sensors,</div>
            <div class="signals">Signals,</div>
            <div class="brain">& the Brain</div>
          </div>
        </div>
      </div>

      <!-- Bio Section -->
      <div class="bio">
        I build technology to understand physiology and behavior. Originally from Amman, currently in San Diego studying children in classrooms using wearable biosensors at UCSD.
      </div>
    </div>
  </div>

  <script>
    // Image tooltip follower
    const imageContainer = document.querySelector('.image-container');
    const tooltip = document.querySelector('.image-tooltip');

    imageContainer.addEventListener('mousemove', (e) => {
      const rect = imageContainer.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      tooltip.style.left = x + 'px';
      tooltip.style.top = y + 'px';
      tooltip.style.transform = 'translate(-50%, -50%)';
    });
  </script>
</SiteLayout>
