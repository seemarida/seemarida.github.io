---
import MainLayout from '../layouts/MainLayout.astro';
import { homeContent } from '../data/homeContent.ts';
import { siteConfig } from '../data/siteConfig.js';
---

<MainLayout
	title={`${siteConfig.name} | Home`}
	description={siteConfig.description}
>
	<!-- ========== HERO ========== -->
	<section class="hero-section min-h-[50vh] flex flex-col md:flex-row items-center justify-between gap-8 px-4 md:px-8 py-16 max-w-6xl mx-auto">
		<!-- Left: Name + tagline -->
		<div class="flex-1 flex flex-col items-start md:items-start text-center md:text-left">
			<h1 class="text-5xl md:text-7xl font-bold text-gray-800 leading-tight" style="margin-bottom: 0.25rem;">
				Seema Rida
			</h1>
			<p class="text-xl md:text-2xl font-bold text-gray-800 leading-tight" style="margin-bottom: 0;">
				Cognitive Science &amp; Machine Learning at UCSD
			</p>
		</div>

		<!-- Right: Brain illustration -->
		<div class="flex-1 flex items-center justify-center">
			<img
				src="/brain_pic.svg"
				alt="Brain illustration"
				class="w-full max-w-md md:max-w-lg"
			/>
		</div>
	</section>

	<!-- ========== PROJECTS GRID ========== -->
	<section class="projects-section max-w-6xl mx-auto px-4 md:px-8 pb-20">
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
			{homeContent.projects.map((project) => (
				<a
					href={`/projects/${project.slug}`}
					class="project-card-link group block"
				>
					<!-- Image / placeholder -->
					<div class="project-img-wrap relative overflow-hidden bg-gray-100 rounded-2xl" style="aspect-ratio: 16/9;">
						{project.image ? (
							<img
								src={project.image}
								alt={project.title}
								class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
							/>
						) : (
							<div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200">
								<svg class="w-16 h-16 text-gray-300 transition-transform duration-500 group-hover:scale-110" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
								</svg>
							</div>
						)}
					</div>

					<!-- Text below image -->
					<div class="pt-4 px-1">
						<h3 class="text-lg font-bold text-gray-800 group-hover:text-gray-600 transition-colors" style="margin-bottom: 0.25rem;">{project.title}</h3>
						<p class="text-xs text-gray-400 leading-relaxed" style="margin-bottom: 0;">{project.fields.join(" · ")}</p>
					</div>
				</a>
			))}
		</div>
	</section>

	<!-- ========== BOTTOM QUOTE ========== -->
	<div class="max-w-2xl mx-auto text-center pb-16 px-4">
		<p class="text-sm text-gray-400 italic">
			This little corner of the internet is where I collect my thoughts about brains, code, and everything in between.
		</p>
		<div class="mt-3 w-12 h-0.5 bg-gradient-to-r from-transparent via-muted-rose to-transparent mx-auto opacity-50"></div>
	</div>
</MainLayout>
