---
import SiteLayout from '../layouts/SiteLayout.astro';
import RetroWindow from '../components/RetroWindow.astro';
---

<SiteLayout>
  <style>
    /* Desktop Layout */
    .desktop {
      display: flex;
      padding: 4rem 0;
      gap: 2rem;
      align-items: start;
      min-height: calc(100vh - 200px);
    }

    .desktop-icons {
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
      padding-left: 24px;
      padding-top: 1rem;
      flex-shrink: 0;
    }

    .desktop-icon {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      text-decoration: none;
      padding: 0;
    }

    .icon-svg {
      width: 72px;
      height: 72px;
    }

    .icon-label {
      font-family: 'VT323', monospace;
      font-size: 1rem;
      color: #1C1917;
      text-align: center;
      line-height: 1.2;
      letter-spacing: 0.05em;
      padding: 0.25rem 0.5rem;
      max-width: 100%;
      transition: none;
    }

    @media (prefers-reduced-motion: no-preference) {
      .desktop-icon:hover .icon-label,
      .desktop-icon:focus .icon-label {
        animation: invertLabel 0.1s steps(1) forwards;
      }
    }

    @keyframes invertLabel {
      to {
        background: #1C1917;
        color: #F8F6F4;
      }
    }

    .desktop-icon:hover .icon-label,
    .desktop-icon:focus .icon-label {
      background: #1C1917;
      color: #F8F6F4;
    }

    .desktop-icon:focus {
      outline: 2px dotted #1C1917;
      outline-offset: 4px;
    }

    /* Main Content */
    .container {
      display: flex;
      justify-content: center;
      align-items: center;
      flex: 1;
      padding-right: 2rem;
    }

    .hero-wrapper {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      width: 100%;
    }

    .hero-section {
      display: flex;
      align-items: flex-start;
      gap: 2rem;
      width: 100%;
    }

    .left-section {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      flex-shrink: 0;
    }

    .image-panel {
      background: radial-gradient(circle, rgba(28, 25, 23, 0.02) 1px, transparent 1px);
      background-size: 12px 12px;
      padding: 1rem;
      border: 2px solid #E7E3DC;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .image-container {
      position: relative;
      display: inline-block;
    }

    @media (prefers-reduced-motion: no-preference) {
      .image-container {
        animation: levitate 2s steps(4) infinite;
      }
    }

    .image-container img {
      width: 140px;
      height: 180px;
      object-fit: cover;
      display: block;
    }

    @keyframes levitate {
      0%, 100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-8px);
      }
    }

    .right-section {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      flex: 1;
    }

    .bio {
      font-family: 'VT323', monospace;
      font-size: 1.125rem;
      color: #1C1917;
      line-height: 1.6;
      letter-spacing: 0.05em;
    }

    .welcome-icon {
      cursor: pointer;
    }

    @media (max-width: 768px) {
      .desktop {
        flex-direction: column;
        padding: 3rem 1rem;
      }

      .desktop-icons {
        flex-direction: row;
        justify-content: center;
        gap: 2rem;
        padding-left: 0;
        padding-top: 0;
        order: 2;
      }

      .container {
        order: 1;
        padding-right: 0;
      }

      .hero-section {
        flex-direction: column;
        gap: 1.5rem;
        align-items: center;
      }
    }
  </style>

  <!-- Main Content -->
  <div class="desktop">
    <!-- Desktop Icons -->
    <div class="desktop-icons">
      <a href="/projects" class="desktop-icon">
        <svg viewBox="0 0 80 80" class="icon-svg" aria-hidden="true">
          <path d="M 10 20 L 40 20 L 45 25 L 70 25 L 70 65 L 10 65 Z"
            fill="#6FAB84" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
          <line x1="10" y1="30" x2="70" y2="30" stroke="#1C1917" stroke-width="1" shape-rendering="crispEdges" />
        </svg>
        <span class="icon-label">projects</span>
      </a>

      <a href="/about" class="desktop-icon">
        <svg viewBox="0 0 80 80" class="icon-svg" aria-hidden="true">
          <path d="M 15 10 L 15 70 L 65 70 L 65 25 L 50 10 Z"
            fill="#F8F6F4" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
          <path d="M 50 10 L 50 25 L 65 25"
            fill="#E7E3DC" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
          <line x1="25" y1="35" x2="55" y2="35" stroke="#6FAB84" stroke-width="2" shape-rendering="crispEdges" />
          <line x1="25" y1="45" x2="55" y2="45" stroke="#6FAB84" stroke-width="2" shape-rendering="crispEdges" />
          <line x1="25" y1="55" x2="45" y2="55" stroke="#6FAB84" stroke-width="2" shape-rendering="crispEdges" />
        </svg>
        <span class="icon-label">about me.txt</span>
      </a>

      <a href="/resume" class="desktop-icon">
        <svg viewBox="0 0 80 80" class="icon-svg" aria-hidden="true">
          <path d="M 15 10 L 15 70 L 65 70 L 65 25 L 50 10 Z"
            fill="#F8F6F4" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
          <path d="M 50 10 L 50 25 L 65 25"
            fill="#E7E3DC" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
          <rect x="20" y="30" width="40" height="35" fill="#6FAB84" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
          <text x="40" y="52" font-family="VT323, monospace" font-size="14" fill="#F8F6F4" text-anchor="middle">PDF</text>
        </svg>
        <span class="icon-label">resume.pdf</span>
      </a>
    </div>

    <div class="container">
    <!-- Minimized welcome.exe icon -->
    <div class="desktop-icon welcome-icon" id="welcomeIcon" style="display: none;">
      <svg viewBox="0 0 80 80" class="icon-svg" aria-hidden="true">
        <!-- Simple document/text file icon with "Hi!" -->
        <path d="M 15 10 L 15 70 L 65 70 L 65 25 L 50 10 Z"
          fill="#F8F6F4" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
        <path d="M 50 10 L 50 25 L 65 25"
          fill="#E7E3DC" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
        <!-- Waving hand emoji style -->
        <text x="40" y="50" font-family="VT323, monospace" font-size="24" fill="#1C1917" text-anchor="middle">Hi!</text>
      </svg>
      <span class="icon-label">welcome.exe</span>
    </div>

    <!-- Welcome window -->
    <div id="welcomeWindow">
      <RetroWindow title="welcome.exe" backLabel="×">
        <div class="hero-wrapper">
          <div class="hero-section">
            <!-- Left Section: Image -->
            <div class="left-section">
              <div class="image-panel">
                <div class="image-container">
                  <img src="/home_drawing.jpg" alt="Seema's illustration" />
                </div>
              </div>
            </div>

            <!-- Right Section: Content -->
            <div class="right-section">
              <div class="bio">
                Hi, I'm Seema. Welcome to my website!
              </div>

              <div class="bio">
                I build tech to understand physiology and behavior. Originally from Amman, studied cognitive science at UC San Diego, now in the Bay Area working on neuromodulation and bioelectronics at Stanford.
              </div>
            </div>
          </div>
        </div>
      </RetroWindow>
    </div>
    </div>

    <script>
      // Handle welcome.exe minimize/restore
      const welcomeWindow = document.getElementById('welcomeWindow');
      const welcomeIcon = document.getElementById('welcomeIcon');
      const closeBtn = welcomeWindow?.querySelector('.close-btn');

      if (closeBtn && closeBtn.getAttribute('href') !== '') {
        closeBtn.addEventListener('click', (e) => {
          e.preventDefault();
          // Minimize window
          welcomeWindow.style.display = 'none';
          welcomeIcon.style.display = 'flex';
        });
      }

      if (welcomeIcon) {
        welcomeIcon.addEventListener('click', () => {
          // Restore window
          welcomeWindow.style.display = 'block';
          welcomeIcon.style.display = 'none';
        });
      }
    </script>
  </div>
</SiteLayout>
