---
import SiteLayout from '../layouts/SiteLayout.astro';
import RetroWindow from '../components/RetroWindow.astro';
---

<SiteLayout>
  <style>
    /* Desktop Layout */
    .desktop {
      max-width: 1200px;
      margin: 0 auto;
      padding: 4rem 2rem;
      display: grid;
      grid-template-columns: 140px 1fr;
      gap: 2rem;
      align-items: start;
      min-height: calc(100vh - 200px);
    }

    .desktop-icons {
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
      padding-top: 1rem;
    }

    .desktop-icon {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      text-decoration: none;
      padding: 0.5rem;
    }

    .icon-svg {
      width: 80px;
      height: 80px;
    }

    .icon-label {
      font-family: 'VT323', monospace;
      font-size: 1rem;
      color: #1C1917;
      text-align: center;
      line-height: 1.2;
      letter-spacing: 0.05em;
      padding: 0.25rem 0.5rem;
      max-width: 100%;
      transition: none;
    }

    @media (prefers-reduced-motion: no-preference) {
      .desktop-icon:hover .icon-label,
      .desktop-icon:focus .icon-label {
        animation: invertLabel 0.1s steps(1) forwards;
      }
    }

    @keyframes invertLabel {
      to {
        background: #1C1917;
        color: #F8F6F4;
      }
    }

    .desktop-icon:hover .icon-label,
    .desktop-icon:focus .icon-label {
      background: #1C1917;
      color: #F8F6F4;
    }

    .desktop-icon:focus {
      outline: 2px dotted #1C1917;
      outline-offset: 4px;
    }

    /* Main Content */
    .container {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .hero-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2rem;
      width: 100%;
    }

    .hero-section {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      gap: 51px;
      width: 100%;
      position: relative;
    }

    .left-section {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
    }

    .greeting {
      font-family: 'Nanum Pen Script', cursive;
      font-size: 32px;
      margin-bottom: 1rem;
      color: #1C1917;
      align-self: center;
    }

    .image-container {
      position: relative;
      display: inline-block;
    }

    @media (prefers-reduced-motion: no-preference) {
      .image-container {
        animation: levitate 2s steps(4) infinite;
      }
    }

    .image-container img {
      width: 195px;
      height: 252px;
      object-fit: cover;
    }

    @keyframes levitate {
      0%, 100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-10px);
      }
    }

    .right-section {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
    }

    .subtitle {
      font-family: 'Nanum Pen Script', cursive;
      font-size: 32px;
      color: #1C1917;
      margin-bottom: 0;
    }

    .subtitle .highlight {
      color: #6FAB84;
    }

    .main-title {
      font-family: 'Libre Baskerville', serif;
      font-weight: 400;
      line-height: 1;
      color: #1C1917;
      text-align: left;
      margin-top: 35px;
    }

    .main-title .sensors {
      font-size: 75px;
      margin-bottom: 27px;
    }

    .main-title .signals {
      font-size: 55px;
      margin-bottom: 27px;
    }

    .main-title .brain {
      font-size: 32px;
    }

    .bio {
      font-size: 1rem;
      font-family: 'Inter', sans-serif;
      font-weight: 300;
      color: #6B7280;
      line-height: 1.7;
      max-width: 750px;
      text-align: center;
    }

    @media (max-width: 768px) {
      .desktop {
        grid-template-columns: 1fr;
        padding: 3rem 1rem;
      }

      .desktop-icons {
        flex-direction: row;
        justify-content: center;
        gap: 2rem;
        padding-top: 0;
        order: 2;
      }

      .container {
        order: 1;
      }

      .hero-section {
        flex-direction: column;
        gap: 2rem;
        align-items: center;
      }

      .main-title .sensors {
        font-size: 50px;
      }

      .main-title .signals {
        font-size: 40px;
      }

      .main-title .brain {
        font-size: 24px;
      }

      .bio {
        text-align: center;
      }
    }
  </style>

  <!-- Main Content -->
  <div class="desktop">
    <!-- Desktop Icons -->
    <div class="desktop-icons">
      <a href="/work" class="desktop-icon">
        <svg viewBox="0 0 80 80" class="icon-svg" aria-hidden="true">
          <path d="M 10 20 L 40 20 L 45 25 L 70 25 L 70 65 L 10 65 Z"
            fill="#6FAB84" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
          <line x1="10" y1="30" x2="70" y2="30" stroke="#1C1917" stroke-width="1" shape-rendering="crispEdges" />
        </svg>
        <span class="icon-label">work</span>
      </a>

      <a href="/about" class="desktop-icon">
        <svg viewBox="0 0 80 80" class="icon-svg" aria-hidden="true">
          <path d="M 15 10 L 15 70 L 65 70 L 65 25 L 50 10 Z"
            fill="#F8F6F4" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
          <path d="M 50 10 L 50 25 L 65 25"
            fill="#E7E3DC" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
          <line x1="25" y1="35" x2="55" y2="35" stroke="#6FAB84" stroke-width="2" shape-rendering="crispEdges" />
          <line x1="25" y1="45" x2="55" y2="45" stroke="#6FAB84" stroke-width="2" shape-rendering="crispEdges" />
          <line x1="25" y1="55" x2="45" y2="55" stroke="#6FAB84" stroke-width="2" shape-rendering="crispEdges" />
        </svg>
        <span class="icon-label">about me.txt</span>
      </a>

      <a href="/resume" class="desktop-icon">
        <svg viewBox="0 0 80 80" class="icon-svg" aria-hidden="true">
          <path d="M 15 10 L 15 70 L 65 70 L 65 25 L 50 10 Z"
            fill="#F8F6F4" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
          <path d="M 50 10 L 50 25 L 65 25"
            fill="#E7E3DC" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
          <rect x="20" y="30" width="40" height="35" fill="#6FAB84" stroke="#1C1917" stroke-width="2" shape-rendering="crispEdges" />
          <text x="40" y="52" font-family="VT323, monospace" font-size="14" fill="#F8F6F4" text-anchor="middle">PDF</text>
        </svg>
        <span class="icon-label">resume.pdf</span>
      </a>
    </div>

    <div class="container">
    <RetroWindow title="hi, i'm seema" backLabel="">
      <div class="hero-wrapper">
        <div class="hero-section">
          <!-- Left Section: Greeting + Image -->
          <div class="left-section">
            <div class="greeting">Hi. I'm Seema</div>
            <div class="image-container">
              <img src="/home_drawing.jpg" alt="Seema's illustration" />
            </div>
          </div>

          <!-- Right Section: Title -->
          <div class="right-section">
            <div class="subtitle">
              <span class="highlight">CogSci researcher</span> exploring
            </div>
            <div class="main-title">
              <div class="sensors">Sensors,</div>
              <div class="signals">Signals,</div>
              <div class="brain">& the Brain</div>
            </div>
          </div>
        </div>

        <!-- Bio Section -->
        <div class="bio">
          I build technology to understand physiology and behavior. Originally from Amman, now in the Bay Area working on wearable biosensing and bioelectronics research at Stanford.
        </div>
      </div>
    </RetroWindow>
    </div>
  </div>
</SiteLayout>
