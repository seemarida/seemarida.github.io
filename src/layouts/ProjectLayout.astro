---
const { title, description, tags, image, demoLink, codeLink } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | seema rida</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <style>
    :root {
      --bg: #FAF8F5; --ink: #1C1917; --green: #4A7260; --green-mid: #D0E4DC;
      --muted: #78716C; --border: #E7E3DC; --card: #FFFFFF; --tag: #EEF4F1;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg); color: var(--ink); font-family: 'Inter', sans-serif; font-size: 15px; line-height: 1.6; -webkit-font-smoothing: antialiased; }

    nav { display: flex; justify-content: space-between; align-items: center; padding: 22px 52px; border-bottom: 1px solid var(--border); position: sticky; top: 0; background: var(--bg); z-index: 100; }
    .nav-left { display: flex; align-items: center; gap: 8px; }
    .nav-left i { color: var(--green); font-size: 1.5rem; }
    .back-link { font-size: 1rem; color: var(--muted); text-decoration: none; transition: color 0.15s; display: flex; align-items: center; gap: 6px; }
    .back-link:hover { color: var(--ink); }

    .project-wrap { max-width: 100%; padding: 72px 15% 100px; }
    .project-header { margin-bottom: 48px; }
    .project-title { font-size: 3rem; font-weight: 600; letter-spacing: -0.03em; line-height: 1.1; margin-bottom: 16px; color: var(--ink); }
    .project-desc { font-size: 1.1rem; color: var(--muted); font-weight: 300; line-height: 1.7; margin-bottom: 24px; }

    .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; }
    .tag { padding: 6px 14px; background: var(--tag); border: 1px solid var(--green-mid); border-radius: 100px; font-size: 0.9rem; color: var(--muted); }

    .project-media { margin-bottom: 48px; border-radius: 12px; overflow: hidden; border: 1px solid var(--border); background: var(--card); }
    .project-media img, .project-media iframe { width: 100%; display: block; }

    .links { display: flex; gap: 12px; margin-bottom: 48px; }
    .link-btn { display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; border: 1px solid var(--border); border-radius: 8px; font-size: 0.95rem; font-weight: 500; color: var(--ink); text-decoration: none; background: var(--card); transition: border-color 0.15s, color 0.15s; }
    .link-btn:hover { border-color: var(--green); color: var(--green); }

    .content { font-size: 1.05rem; color: var(--ink); font-weight: 300; line-height: 1.8; }
    .content h2 { font-size: 1.8rem; font-weight: 800; margin-top: 48px; margin-bottom: 20px; color: var(--ink); letter-spacing: -0.02em; }
    .content h2:first-of-type { margin-top: 0; }
    .content p { margin-bottom: 20px; color: var(--muted); }
    .content ul, .content ol { margin-left: 24px; margin-bottom: 20px; color: var(--muted); }
    .content li { margin-bottom: 10px; }

    footer { border-top: 1px solid var(--border); padding: 32px 52px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-top: 80px; }
    .fn { font-size: 0.95rem; color: var(--muted); }
    .fl { display: flex; gap: 26px; list-style: none; }
    .fl a { font-size: 0.92rem; color: var(--muted); text-decoration: none; transition: color 0.15s; }
    .fl a:hover { color: var(--ink); }

    @media (max-width: 1024px) { .project-wrap { padding: 60px 10% 80px; } }
    @media (max-width: 768px) { .project-wrap { padding: 48px 8% 80px; } }
    @media (max-width: 600px) {
      nav { padding: 18px 20px; }
      .project-wrap { padding: 48px 6% 80px; }
      footer { padding: 22px 20px; flex-direction: column; }
      .links { flex-direction: column; }
    }
  </style>
</head>
<body>

<nav>
  <a href="/#projects" class="back-link">← back to work</a>
  <div></div>
</nav>

<div class="project-wrap">
  <div class="project-header">
    <h1 class="project-title">{title}</h1>
    <p class="project-desc">{description}</p>
    <div class="tags">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </div>

  {image && (
    <div class="project-media">
      <img src={image} alt={title} />
    </div>
  )}

  {(demoLink || codeLink) && (
    <div class="links">
      {demoLink && <a href={demoLink} class="link-btn" target="_blank">View Demo →</a>}
      {codeLink && <a href={codeLink} class="link-btn" target="_blank">View Code →</a>}
    </div>
  )}

  <div class="content">
    <slot />
  </div>
</div>

<footer>
  <span class="fn">© 2026</span>
  <ul class="fl">
    <li><a href="https://www.linkedin.com/in/seema-rida/" target="_blank">linkedin</a></li>
    <li><a href="https://github.com/seemarida" target="_blank">github</a></li>
    <li><a href="mailto:seemazrida@gmail.com">email</a></li>
    <li><a href="https://open.spotify.com/user/wyklimh7i9katv6ph7rwdc3oz" target="_blank">spotify</a></li>
  </ul>
</footer>

</body>
</html>
