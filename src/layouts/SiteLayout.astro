---
import { footerSocialLinks } from '../data/siteConfig';

const { title = "Seema Rida", description = "CogSci researcher exploring sensors, signals, & the brain" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nanum+Pen+Script&family=Libre+Baskerville:wght@400;700&family=Inter:wght@300;400;500;600&family=VT323&display=swap" rel="stylesheet" />

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      height: 100%;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: #F8F6F4;
      background-image: radial-gradient(circle, rgba(28, 25, 23, 0.05) 1px, transparent 1px);
      background-size: 20px 20px;
      color: #1C1917;
      line-height: 1.6;
      cursor: none;
      display: flex;
      flex-direction: column;
    }

    main {
      flex: 1;
    }

    /* Custom Cursor */
    .cursor {
      width: 12px;
      height: 12px;
      border-radius: 0;
      background: rgba(28, 25, 23, 0.6);
      position: fixed;
      pointer-events: none;
      z-index: 9999;
      transform: translate(-50%, -50%);
      transition: transform 0.15s ease-out;
    }

    /* Navigation Bar */
    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.5rem 2rem;
      position: sticky;
      top: 0;
      background: #F8F6F4;
      border-bottom: 2px solid #1C1917;
      z-index: 1000;
    }

    .nav-left {
      display: flex;
      align-items: center;
      gap: 2rem;
    }

    .nav-left a {
      text-decoration: none;
      color: #1C1917;
      font-size: 1rem;
      font-family: 'VT323', monospace;
      letter-spacing: 0.05em;
      padding: 0.25rem 0.5rem;
      transition: none;
    }

    .nav-left a:not(.logo):hover {
      color: #6FAB84;
    }

    .nav-left a:not(.logo):focus {
      outline: 2px solid #6FAB84;
      outline-offset: 4px;
    }

    .nav-left a.current {
      background: #1C1917;
      color: #F8F6F4;
    }

    .logo {
      font-family: 'Nanum Pen Script', cursive;
      font-size: 1.5rem;
      color: #6FAB84;
      font-weight: 400;
      display: inline-block;
      text-decoration: none;
      cursor: pointer;
      padding: 0;
    }

    .logo span {
      display: inline-block;
      transition: transform 0.3s ease;
    }

    @media (prefers-reduced-motion: no-preference) {
      .logo:hover .logo-s {
        transform: translate(-3px, -3px);
      }

      .logo:hover .logo-r {
        transform: translate(3px, 3px);
      }
    }

    .logo:hover .logo-s {
      transform: translate(-3px, -3px);
    }

    .logo:hover .logo-r {
      transform: translate(3px, 3px);
    }

    .clocks {
      font-family: 'VT323', monospace;
      font-size: 1rem;
      color: #1C1917;
      letter-spacing: 0.05em;
      display: flex;
      gap: 1.5rem;
    }

    @media (max-width: 768px) {
      nav {
        padding: 0.5rem 1rem;
      }

      .nav-left {
        gap: 1rem;
      }

      .logo {
        font-size: 1.25rem;
      }

      .clocks {
        font-size: 0.875rem;
        flex-direction: column;
        gap: 0.25rem;
        text-align: right;
      }

      .clock-amman {
        display: none;
      }
    }

    /* Footer */
    footer {
      border-top: 2px solid #1C1917;
      background: #F8F6F4;
      padding: 0.5rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: 'VT323', monospace;
      font-size: 1rem;
      color: #1C1917;
      letter-spacing: 0.05em;
    }

    .footer-links {
      display: flex;
      gap: 1.5rem;
      list-style: none;
    }

    .footer-links a {
      text-decoration: none;
      color: #1C1917;
      transition: color 0.2s ease;
    }

    .footer-links a:hover {
      color: #6FAB84;
    }

    .footer-links a:focus {
      outline: 2px solid #6FAB84;
      outline-offset: 4px;
    }

    @media (max-width: 768px) {
      footer {
        padding: 0.5rem 1rem;
        flex-direction: column;
        gap: 0.5rem;
      }

      .footer-links {
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: center;
      }
    }
  </style>
</head>
<body>
  <!-- Custom Cursor -->
  <div class="cursor"></div>

  <!-- Navigation -->
  <nav>
    <div class="nav-left">
      <a href="/" class="logo"><span class="logo-s">S</span><span class="logo-r">R</span></a>
      <a href="/projects" class={currentPath.startsWith('/projects') ? 'current' : ''}>projects</a>
      <a href="/about" class={currentPath.startsWith('/about') ? 'current' : ''}>about</a>
      <!-- Future: Gallery and Contact pages -->
      <!-- <a href="/gallery">gallery</a> -->
      <!-- <a href="/contact">contact</a> -->
    </div>
    <div class="clocks" aria-hidden="true">
      <time class="clock-california"></time>
      <time class="clock-amman"></time>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer>
    <span>(c) 2026 seema rida</span>
    <ul class="footer-links">
      {footerSocialLinks.map(link => (
        <li>
          <a href={link.href} target={link.name !== 'Email' ? '_blank' : undefined} rel={link.name !== 'Email' ? 'noopener noreferrer' : undefined}>
            {link.name.toLowerCase()}
          </a>
        </li>
      ))}
    </ul>
  </footer>

  <script>
    // Custom cursor follower
    const cursor = document.querySelector('.cursor');

    document.addEventListener('mousemove', (e) => {
      cursor.style.left = e.clientX + 'px';
      cursor.style.top = e.clientY + 'px';
    });

    // Dual timezone clocks
    const clockCalifornia = document.querySelector('.clock-california');
    const clockAmman = document.querySelector('.clock-amman');

    function updateClocks() {
      const now = new Date();

      // California time (America/Los_Angeles)
      const californiaFormatter = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/Los_Angeles',
        weekday: 'short',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false
      });
      const californiaParts = californiaFormatter.formatToParts(now);
      const caWeekday = californiaParts.find(p => p.type === 'weekday').value.toLowerCase();
      const caHour = californiaParts.find(p => p.type === 'hour').value;
      const caMinute = californiaParts.find(p => p.type === 'minute').value;
      clockCalifornia.textContent = `california ${caWeekday} ${caHour}:${caMinute}`;

      // Amman time (Asia/Amman)
      const ammanFormatter = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Asia/Amman',
        weekday: 'short',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false
      });
      const ammanParts = ammanFormatter.formatToParts(now);
      const amWeekday = ammanParts.find(p => p.type === 'weekday').value.toLowerCase();
      const amHour = ammanParts.find(p => p.type === 'hour').value;
      const amMinute = ammanParts.find(p => p.type === 'minute').value;
      clockAmman.textContent = `amman ${amWeekday} ${amHour}:${amMinute}`;
    }

    updateClocks();
    setInterval(updateClocks, 60000); // Update every minute
  </script>
</body>
</html>
