---
import { footerSocialLinks } from '../data/siteConfig';

const { title = "Seema Rida", description = "CogSci researcher exploring sensors, signals, & the brain" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nanum+Pen+Script&family=Libre+Baskerville:wght@400;700&family=Inter:wght@300;400;500;600&family=VT323&display=swap" rel="stylesheet" />

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: #F8F6F4;
      color: #1C1917;
      line-height: 1.6;
      cursor: none;
    }

    /* Custom Cursor */
    .cursor {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: rgba(107, 114, 128, 0.5);
      position: fixed;
      pointer-events: none;
      z-index: 9999;
      transform: translate(-50%, -50%);
      transition: transform 0.15s ease-out;
    }

    /* Navigation Bar */
    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.5rem 2rem;
      position: sticky;
      top: 0;
      background: #F8F6F4;
      border-bottom: 2px solid #1C1917;
      z-index: 1000;
    }

    .nav-left {
      display: flex;
      align-items: center;
      gap: 2rem;
    }

    .nav-left a {
      text-decoration: none;
      color: #1C1917;
      font-size: 1rem;
      font-family: 'VT323', monospace;
      letter-spacing: 0.05em;
    }

    .nav-left a:hover {
      color: #6FAB84;
    }

    .nav-left a:focus {
      outline: 2px solid #6FAB84;
      outline-offset: 4px;
    }

    .logo {
      font-family: 'Nanum Pen Script', cursive;
      font-size: 1.5rem;
      color: #6FAB84;
      font-weight: 400;
      display: inline-block;
      text-decoration: none;
      cursor: pointer;
    }

    .logo span {
      display: inline-block;
      transition: transform 0.3s ease;
    }

    .logo:hover .logo-s {
      transform: translate(-3px, -3px);
    }

    .logo:hover .logo-r {
      transform: translate(3px, 3px);
    }

    .clock {
      font-family: 'VT323', monospace;
      font-size: 1rem;
      color: #1C1917;
      letter-spacing: 0.05em;
    }

    @media (max-width: 768px) {
      nav {
        padding: 0.5rem 1rem;
      }

      .nav-left {
        gap: 1rem;
      }

      .logo {
        font-size: 1.25rem;
      }

      .clock {
        font-size: 0.875rem;
      }
    }

    /* Footer */
    footer {
      border-top: 2px solid #1C1917;
      background: #F8F6F4;
      padding: 0.5rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: 'VT323', monospace;
      font-size: 1rem;
      color: #1C1917;
      letter-spacing: 0.05em;
    }

    .footer-links {
      display: flex;
      gap: 1.5rem;
      list-style: none;
    }

    .footer-links a {
      text-decoration: none;
      color: #1C1917;
      transition: color 0.2s ease;
    }

    .footer-links a:hover {
      color: #6FAB84;
    }

    .footer-links a:focus {
      outline: 2px solid #6FAB84;
      outline-offset: 4px;
    }

    @media (max-width: 768px) {
      footer {
        padding: 0.5rem 1rem;
        flex-direction: column;
        gap: 0.5rem;
      }

      .footer-links {
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: center;
      }
    }
  </style>
</head>
<body>
  <!-- Custom Cursor -->
  <div class="cursor"></div>

  <!-- Navigation -->
  <nav>
    <div class="nav-left">
      <a href="/" class="logo"><span class="logo-s">S</span><span class="logo-r">R</span></a>
      <a href="/work">work</a>
      <a href="/about">about</a>
      <!-- Future: Gallery and Contact pages -->
      <!-- <a href="/gallery">gallery</a> -->
      <!-- <a href="/contact">contact</a> -->
    </div>
    <div class="clock" aria-hidden="true"></div>
  </nav>

  <slot />

  <!-- Footer -->
  <footer>
    <span>© 2026 seema rida</span>
    <ul class="footer-links">
      {footerSocialLinks.map(link => (
        <li>
          <a href={link.href} target={link.name !== 'Email' ? '_blank' : undefined} rel={link.name !== 'Email' ? 'noopener noreferrer' : undefined}>
            {link.name.toLowerCase()}
          </a>
        </li>
      ))}
    </ul>
  </footer>

  <script>
    // Custom cursor follower
    const cursor = document.querySelector('.cursor');

    document.addEventListener('mousemove', (e) => {
      cursor.style.left = e.clientX + 'px';
      cursor.style.top = e.clientY + 'px';
    });

    // Live clock
    const clockElement = document.querySelector('.clock');

    function updateClock() {
      const now = new Date();
      const hours = String(now.getHours()).padStart(2, '0');
      const minutes = String(now.getMinutes()).padStart(2, '0');
      clockElement.textContent = `${hours}:${minutes}`;
    }

    updateClock();
    setInterval(updateClock, 60000); // Update every minute
  </script>
</body>
</html>
